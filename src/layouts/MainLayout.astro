---
// src/layouts/MainLayout.astro
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  keywords?: string;
  ogTitle?: string;
  ogDescription?: string;
}

// Set default fallback values in case a page forgets to pass them
const {
  title = "Laga Handkontroll Malmö | Stick Drift & TMR Fix | mkFix",
  description = "Fixa stick drift permanent i Malmö! TMR & Hall Effect uppgraderingar för PS5, Xbox och Switch. Snabbt med 6 månaders garanti.",
  canonicalUrl = Astro.url.href, // Dynamically gets current URL
  keywords = "stick drift repair malmö, laga handkontroll malmö, TMR sensor upgrade, laga PS5 kontroll malmö, nintendo switch lagning",
  ogTitle = "MKFix - Säg hejdå till Stick Drift",
  ogDescription = "Vi uppgraderar din kontroll till nästa nivå med TMR-stickor och custom mods i Malmö.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonicalUrl}>

    <link rel="icon" type="image/png" href="https://mkfix.se/assets/favicon.png">
    <meta name="trustpilot-one-time-domain-verification-id" content="a30096a5-8452-441b-b35b-20d2dc50bdbe" />
    <meta name="keywords" content={keywords}>
    <meta name="author" content="MKFix">

    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:title" content={ogTitle}>
    <meta property="og:description" content={ogDescription}>
    <meta property="og:image" content="https://mkfix.se/assets/og-image.jpg">

    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content={canonicalUrl}>
    <meta property="twitter:title" content="MKFix - Handkontrollsservice">
    <meta property="twitter:description" content="Professionell lagning av DualSense och DualShock i Malmö. TMR-uppgraderingar och mer!">
    <meta property="twitter:image" content="https://mkfix.se/assets/og-image.jpg">

    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "mkFix Malmö",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Malmö",
        "addressCountry": "SE"
      },
      "url": "https://mkfix.se",
      "priceRange": "SEK"
    }
    </script>

    <link rel="stylesheet" href="/global.css">
</head>
<body>
        <slot /> 

    </body>
</html>