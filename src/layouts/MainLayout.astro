---
// src/layouts/MainLayout.astro
interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  keywords?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
}

// Set default fallback values in case a page forgets to pass them
const {
  title = "Laga & Modifiera Kontroller, Konsoler & Elektronik | Malmö | mkFix",
  description = "Vi lagar och modifierar kontroller, konsoler och elektronik i Malmö & via post i hela Sverige. TMR-sensorer, HDMI-portar, mikrolödning och 6 månaders garanti.",
  canonicalUrl: propCanonicalUrl,
  keywords = "laga kontroller malmö, laga konsol malmö, elektronikreparation malmö, stick drift repair malmö, TMR sensor upgrade, laga PS5 kontroll malmö, laga xbox malmö, nintendo switch lagning",
  ogTitle = "mkFix - Laga & Modifiera Kontroller, Konsoler & Elektronik",
  ogDescription = "Vi lagar och modifierar kontroller, konsoler och elektronik i Malmö eller via post från hela Sverige.",
  ogType = "website",
  ogImage = "https://mkfix.se/assets/og-image.jpg",
  noindex = false,
  jsonLd,
} = Astro.props;

// Ensure canonical URL always has a trailing slash for directory routes
const rawCanonical = propCanonicalUrl || Astro.url.href;
const canonicalUrl = (() => {
  try {
    const parsed = new URL(rawCanonical, "https://mkfix.se");
    if (!parsed.pathname.endsWith("/") && !parsed.pathname.split("/").pop()?.includes(".")) {
      parsed.pathname = `${parsed.pathname}/`;
    }
    return parsed.href;
  } catch {
    return rawCanonical.endsWith("/") ? rawCanonical : `${rawCanonical}/`;
  }
})();

const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "ElectronicsRepairShop",
  "name": "mkFix Malmö",
  "image": ogImage,
  "url": "https://mkfix.se/",
  "telephone": "+46790320605",
  "priceRange": "SEK",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Malmö",
    "addressCountry": "SE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "addressCountry": "SE"
  },
  "areaServed": [
    {
      "@type": "City",
      "name": "Malmö"
    },
    {
      "@type": "Country",
      "name": "Sverige"
    }
  ],
  "sameAs": [
    "https://www.youtube.com/@mkFix-pl",
    "https://www.instagram.com/mkfix.yt",
    "https://www.facebook.com/profile.php?id=61584151330442",
    "https://x.com/mkfix_yt",
    "https://discord.gg/s75Kww368a"
  ]
};

const schemas = jsonLd
  ? (Array.isArray(jsonLd) ? [defaultSchema, ...jsonLd] : [defaultSchema, jsonLd])
  : [defaultSchema];
---

<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{title}</title>
    <meta name="description" content={description}>
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}
    <link rel="canonical" href={canonicalUrl}>

    <link rel="icon" type="image/png" href="https://mkfix.se/assets/favicon.png">
    <meta name="trustpilot-one-time-domain-verification-id" content="a30096a5-8452-441b-b35b-20d2dc50bdbe" />
    {keywords && <meta name="keywords" content={keywords}>}
    <meta name="author" content="mkFix">

    <meta property="og:type" content={ogType}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:title" content={ogTitle}>
    <meta property="og:description" content={ogDescription}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:site_name" content="mkFix">
    <meta property="og:locale" content="sv_SE">

    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content={canonicalUrl}>
    <meta property="twitter:title" content={ogTitle}>
    <meta property="twitter:description" content={ogDescription}>
    <meta property="twitter:image" content={ogImage}>

    {schemas.map(schema => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)}></script>
    ))}

    <link rel="stylesheet" href="/global.css">
</head>
<body>
        <slot /> 

    </body>
</html>