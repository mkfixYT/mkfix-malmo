---
// src/layouts/BlogLayout.astro
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MainLayout from './MainLayout.astro';

interface Props {
  frontmatter: any;
}

const { frontmatter } = Astro.props;

const pageTitle = frontmatter.title.includes("mkFix")
  ? frontmatter.title
  : `${frontmatter.title} | mkFix Blogg`;

const canonicalUrl = frontmatter.canonicalUrl || Astro.url.href;

const blogPostingSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": frontmatter.title,
  "description": frontmatter.description,
  "url": canonicalUrl,
  "datePublished": frontmatter.pubDate || "2026-01-01",
  "author": {
    "@type": "Organization",
    "name": "mkFix",
    "url": "https://mkfix.se"
  },
  "publisher": {
    "@type": "Organization",
    "name": "mkFix",
    "url": "https://mkfix.se"
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  }
};
---

<MainLayout
  title={pageTitle}
  canonicalUrl={canonicalUrl}
  keywords={frontmatter.keywords}
  ogTitle={frontmatter.ogTitle || frontmatter.title}
  ogDescription={frontmatter.ogDescription || frontmatter.description}
  ogType="article"
  description={frontmatter.description}
  jsonLd={blogPostingSchema}
>
<Header />
  <main class="container">
    <article style="padding: 4rem 0;">
      <header style="text-align: center; margin-bottom: 3rem; background: transparent; border: none; position: static;">
        <span class="price-badge">{frontmatter.badge || 'Case Study'}</span>
        <h1 style="font-size: 3rem; margin: 1rem 0;">{frontmatter.title}</h1>
        <p style="color: var(--text-dim);">
          Publicerat: {frontmatter.pubDate || 'Nyligen'} | Plats: Malmö
        </p>
      </header>

      <div style="max-width: 800px; margin: 0 auto;">
        
        {/* THE MAGIC SLOT: Your compiled markdown text & images are injected here */}
        <div class="blog-content">
          <slot />
        </div>

        <div class="contact-card" style="margin-top: 4rem;">
          <h2>Behöver du hjälp med din enhet?</h2>
          <p>Vi lagar kontroller, konsoler och annan elektronik i Malmö eller via post.</p>
          <a href="/#boka" class="submit-btn" style="text-decoration: none; display: inline-block; margin-top: 1rem;">
            BOKA REPARATION HÄR
          </a>
          <p style="margin-top: 1rem; font-size: 0.8rem;">Eller SMS:a 079-032 06 05</p>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</MainLayout>

<style is:global>
  /* Optional: Tweak Markdown Elements globally inside your blog posts */
  .blog-content p {
    font-size: 1.15rem;
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }
  .blog-content h2 {
    color: var(--accent);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
</style>