---
// src/pages/foretag.astro
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const b2bServiceSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "name": "B2B Reparation & Bulkservice för Spelbutiker | mkFix Malmö",
  "description": "Verkstadspartner för retrobutiker och spelhandlare i Sverige. Vi erbjuder bulkreparation av handkontroller (PS1-PS5, Xbox, Nintendo), konsoler (laserbyten, recap) och spelkassetter (batteribyten).",
  "provider": {
    "@type": "ElectronicsRepairShop",
    "name": "mkFix",
    "url": "https://mkfix.se",
    "telephone": "+46790320605",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Malmö",
      "addressCountry": "SE"
    }
  },
  "areaServed": [
    { "@type": "City", "name": "Malmö" },
    { "@type": "Country", "name": "Sverige" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Företagstjänster & Bulkreparationer",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Bulk Reparation av Handkontroller (PS1-PS5, Xbox, Nintendo Switch)"
        },
        "description": "Reparation och TMR/Hall Effect-uppgraderingar vid partier om 5+ kontroller."
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Konsolservice & Felsökning i Volym"
        },
        "description": "Laserbyte, recap (kondensatorer), rengöring och reparation av retro- och moderna konsoler."
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Cartridge Batteribyte med Mikrolödning (Bulk)"
        },
        "description": "Byte av sparbatterier i Game Boy, GBA, SNES och N64 med fabrikslödda stift vid större partier."
      }
    ]
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Hur fungerar bulkpriser för spelbutiker och företag?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "När ni skickar in flera enheter samtidigt (från 5 enheter och uppåt) erbjuder vi kraftigt reducerade styckpriser jämfört med konsumentpriser. Ju större parti, desto bättre marginal får ni på era inbyten och lager."
      }
    },
    {
      "@type": "Question",
      "name": "Vilka handkontroller och konsoler reparerar ni?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Vi reparerar handkontroller från PlayStation (PS1, PS2, PS3, PS4, PS5), Xbox (Original, 360, One, Series X/S), Nintendo (NES, SNES, N64, GameCube, Switch Joy-Cons med TMR) samt retrokonsoler (laserbyten, recap-kondensatorer på Game Gear m.fl.) och cartridges (Pokemon, Zelda m.fl.)."
      }
    },
    {
      "@type": "Question",
      "name": "Kan vi som butik utanför Malmö skicka in partier?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, absolut! Många av våra samarbetspartners finns runt om i hela Sverige. Ni packar era enheter i en samlingslåda och skickar via PostNord Företagspaket eller vanligt spårbart paket. Vi returnerar spårbart och försäkrat."
      }
    },
    {
      "@type": "Question",
      "name": "Får vi garanti på reparationerna?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, vi lämnar alltid 6 månaders funktionsgaranti på utförda reparationer och nya komponenter (t.ex. TMR-sensorer och sparbatterier), så att ni kan sälja varorna vidare till era slutkunder med full trygghet."
      }
    },
    {
      "@type": "Question",
      "name": "Hur sker fakturering och betalning?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Vi fakturerar med specificerad moms och F-skatt. Företag kan få faktura med 14–30 dagars betalningsvillkor efter sedvanlig kontroll, eller betala via Swish/kort vid utlämning."
      }
    }
  ]
};
---

<MainLayout
  title="Reparation av Kontroller & Konsoler för Företag & Spelbutiker | Bulkservice | mkFix"
  description="Verkstadspartner för spelbutiker (Spelgalaxen, Nostalgibutiken m.fl.). Vi lagar kontroller, konsoler och cartridges i bulk till förmånliga B2B-priser med 6 mån garanti."
  keywords="reparation retrospel företag, laga kontroller butik, bulk reparation handkontroller, konsolreparation B2B, Spelgalaxen Nostalgibutiken retrobutik, batteribyte cartridges bulk, laga ps1 ps2 ps3 ps4 ps5 kontroller företag, xbox reparation bulk, switch joycon reparation företag, serviceavtal spelbutik, mkfix b2b"
  ogTitle="Företagsservice & Bulkreparationer för Spelbutiker | mkFix"
  ogDescription="Öka lönsamheten på inbyten och defekt lager. Vi reparerar kontroller, konsoler och cartridges i volym för butiker i hela Sverige."
  canonicalUrl="https://mkfix.se/foretag"
  jsonLd={[b2bServiceSchema, faqSchema]}
>
  <Header />

  <main class="container">
    <!-- Hero Section -->
    <section class="hero b2b-hero">
      <div class="trust-box">
        <span class="trust-badge">B2B &amp; BUTIKSPARTNER</span>
        <span>Verkstadsservice för spelhandlare i hela Sverige</span>
      </div>

      <h1>
        Laga kontroller, konsoler &amp; cartridges i <span>bulk</span>
      </h1>
      
      <p class="b2b-lead">
        Har ni en låda med driftande handkontroller, konsoler som inte läser skivor eller Game Boy-spel med döda batterier som samlar damm på lagret? 
        <strong>mkFix</strong> är verkstadspartnern för spelbutiker och retrohandlare (som t.ex. <em>Spelgalaxen</em>, <em>Nostalgibutiken</em> m.fl.). 
        Vi förvandlar ert defekta inbyteslager till säljklara topprodukter med <strong>förmånliga bulkpriser</strong> och <strong>6 månaders garanti</strong>.
      </p>

      <div class="hero-actions">
        <a href="#kontakt-form" class="cta-primary">BEGÄR BULK-OFFERT HÄR</a>
        <a href="sms:+46790320605" class="cta-secondary">📱 SMS:A DIREKT (079-032 06 05)</a>
      </div>

      <!-- Quick Contact Pills -->
      <div class="quick-contact-bar">
        <span>Snabba kontaktvägar:</span>
        <a href="sms:+46790320605" class="pill-link">💬 SMS: 079-032 06 05</a>
        <a href="tel:0790320605" class="pill-link">📞 Ring: 079-032 06 05</a>
        <a href="mailto:kontakt@mkfix.se" class="pill-link">✉️ kontakt@mkfix.se</a>
      </div>
    </section>

    <!-- Value Proposition Grid -->
    <section class="b2b-benefits-section">
      <h2 class="section-title">Varför samarbeta med mkFix?</h2>
      <p class="section-sub">Att reparera själva stjäl tid från butiksdriften, och att sälja som "defekt" ger minimal vinst. Låt oss sköta verkstadsarbetet:</p>

      <div class="grid benefits-grid">
        <div class="card benefit-card">
          <div class="benefit-icon">📦</div>
          <h3>Förmånliga Bulkpriser</h3>
          <p>
            Skicka in 5, 10 eller 50 enheter samtidigt. Ju större parti, desto lägre styckpris. Ni behåller en sund marginal när varan säljs vidare till slutkund.
          </p>
        </div>

        <div class="card benefit-card">
          <div class="benefit-icon">⚡</div>
          <h3>Snabb Turnaround</h3>
          <p>
            Varor på lagret genererar inga intäkter. Vi prioriterar företagspartier och säkerställer att ni snabbt får tillbaka era enheter, snyggt testade och redo för butikshyllan.
          </p>
        </div>

        <div class="card benefit-card">
          <div class="benefit-icon">🛡️</div>
          <h3>6 Månaders Garanti</h3>
          <p>
            Alla reparationer och komponenter (TMR-sensorer, batterier, lasrar m.m.) lämnas med 6 månaders full garanti. Sälj vidare med 100% trygghet till era kunder.
          </p>
        </div>

        <div class="card benefit-card">
          <div class="benefit-icon">📹</div>
          <h3>Full Dokumentation &amp; Testning</h3>
          <p>
            Varje enhet genomgår funktionstest (stick center, knappar, läsbarhet). Vid önskemål livestreamas eller spelas reparationen in på vår YouTube-kanal för total transparens.
          </p>
        </div>

        <div class="card benefit-card">
          <div class="benefit-icon">🧾</div>
          <h3>Faktura med F-skatt &amp; Moms</h3>
          <p>
            Smidig redovisning och avdragsgill moms. Vi ställer ut specificerade fakturor med F-skatt direkt till ert företag.
          </p>
        </div>

        <div class="card benefit-card">
          <div class="benefit-icon">🚚</div>
          <h3>Sverigetäckande Logistik</h3>
          <p>
            Verkstaden ligger i Malmö, men vi tar emot paket från hela Sverige. Packa en samlingslåda med PostNord Företagspaket så löser vi resten.
          </p>
        </div>
      </div>
    </section>

    <!-- Services Overview Tailored to Stores -->
    <section class="b2b-services-section">
      <h2 class="section-title">Vad kan vi hjälpa er butik att laga?</h2>
      <p class="section-sub">Vi hanterar allt från de äldsta retroklenoderna till dagens moderna konsoler:</p>

      <div class="services-wrapper">
        <!-- 1. Handkontroller -->
        <div class="platform-group">
          <div class="platform-header">
            <div class="platform-icon">🎮</div>
            <div>
              <p class="platform-title">Handkontroller i Bulk (Alla Generationer)</p>
              <p class="platform-subtitle">PlayStation, Xbox &amp; Nintendo – Stick drift, slitage, moddar</p>
            </div>
          </div>
          
          <div class="service-grid">
            <div class="service-card featured">
              <div class="tags-row">
                <span class="service-tag bundle-tag">🔥 STORSÄLJARE</span>
                <span class="service-tag save-tag">Bulkpris vid 5+</span>
              </div>
              <p class="service-name">PS5 DualSense &amp; Xbox Series TMR Upgrade</p>
              <span class="service-price">Företagsrabatt <small>vid parti</small></span>
              <p class="service-desc">
                Byt ut driftande analoga spakar mot magnetiska TMR-sensorer. Skapa "driftfria" premiumkontroller som ni kan sälja till ett högre pris i butiken.
              </p>
            </div>

            <div class="service-card">
              <div class="tags-row">
                <span class="service-tag time">⚡ Snabb vändning</span>
              </div>
              <p class="service-name">PlayStation 1, 2, 3 &amp; 4 Kontroller</p>
              <span class="service-price">Volympris</span>
              <p class="service-desc">
                PS2 flex-PCB kabelbyten, nya Alps-joysticks, byte av slitna tumgrepp, rengöring av knappsatser och nya högkapacitetsbatterier för PS4 DualShock.
              </p>
            </div>

            <div class="service-card featured">
              <div class="tags-row">
                <span class="service-tag bundle-tag">🔴 POPULÄRT</span>
              </div>
              <p class="service-name">Nintendo Switch Joy-Con &amp; Pro Controller</p>
              <span class="service-price">Mängdrabatt</span>
              <p class="service-desc">
                Har ni en hög med driftande Joy-Cons? Vi byter till moderna Hall Effect / TMR-stickor som aldrig utvecklar drift igen. Låsbleck, knappar och skenor kan också bytas.
              </p>
            </div>

            <div class="service-card">
              <p class="service-name">Nintendo Retro (GameCube, N64, SNES)</p>
              <span class="service-price">Volympris</span>
              <p class="service-desc">
                Slappa N64-joysticks, slitna GameCube analog- &amp; C-stickor, kabelbrott samt byte av ledande gummimembran för perfekt respons i knapparna.
              </p>
            </div>
          </div>
        </div>

        <!-- 2. Konsoler -->
        <div class="platform-group">
          <div class="platform-header">
            <div class="platform-icon">🕹️</div>
            <div>
              <p class="platform-title">Konsolservice &amp; Felsökning</p>
              <p class="platform-subtitle">Rädda defekta inbyteskonsoler och förvandla dem till vinst</p>
            </div>
          </div>

          <div class="service-grid">
            <div class="service-card featured">
              <div class="tags-row">
                <span class="service-tag save-tag">Högt andrahandsvärde</span>
              </div>
              <p class="service-name">Laserbyten &amp; Drivverksreparation</p>
              <span class="service-price">Fast B2B-pris</span>
              <p class="service-desc">
                PS1, PS2 (Fat &amp; Slim), Nintendo GameCube, original Xbox och Dreamcast som inte läser skivor eller hackar. Byte av laser och potentiometerkalibrering.
              </p>
            </div>

            <div class="service-card">
              <div class="tags-row">
                <span class="service-tag warning-tag">Klassisk retro-åkomma</span>
              </div>
              <p class="service-name">Kondensatorbyten (Full Recap)</p>
              <span class="service-price">Offert vid parti</span>
              <p class="service-desc">
                Läckande elektrolytkondensatorer på Sega Game Gear (svag bild/inget ljud), Amiga, Sega Mega Drive och SNES. Vi byter till moderna kvalitetskondensatorer.
              </p>
            </div>

            <div class="service-card">
              <p class="service-name">Djuprengöring, Kylpasta &amp; Fläktar</p>
              <span class="service-price">Mängdrabatt</span>
              <p class="service-desc">
                PS4 och PS5 som låter som jetplan. Ultraljudstvätt, borttagning av dammklumpar och applicering av Arctic MX-6 eller flytande metall.
              </p>
            </div>

            <div class="service-card">
              <p class="service-name">PicoBoot &amp; Hårdvarumods</p>
              <span class="service-price">Från 1 st till partier</span>
              <p class="service-desc">
                Installation av Raspberry Pi PicoBoot i Nintendo GameCube, regionsfria bios och HDMI-uppgraderingar som gör retrokonsoler extra eftertraktade i butiken.
              </p>
            </div>
          </div>
        </div>

        <!-- 3. Cartridges / Kassetter -->
        <div class="platform-group">
          <div class="platform-header">
            <div class="platform-icon">💾</div>
            <div>
              <p class="platform-title">Cartridges &amp; Spelkassetter (Spelsparminne)</p>
              <p class="platform-subtitle">Game Boy, GBC, GBA, SNES, N64 – Spara spelet igen</p>
            </div>
          </div>

          <div class="service-grid">
            <div class="service-card featured">
              <div class="tags-row">
                <span class="service-tag save-tag">Superenkelt att skicka i parti</span>
              </div>
              <p class="service-name">Batteribyte i Kassetter (Bulk)</p>
              <span class="service-price">Mycket lågt styckpris vid 10+</span>
              <p class="service-desc">
                Kunder vill inte köpa ett Pokémon- eller Zelda-spel där sparfilen försvinner. Vi mikrolöder fast fabriksnya Panasonic/Maxell-batterier med korrekta stift. Håller i 15–20 år!
              </p>
            </div>

            <div class="service-card">
              <p class="service-name">Kontaktbensrengöring &amp; Ultraljudstvätt</p>
              <span class="service-price">Ingår ofta vid parti</span>
              <p class="service-desc">
                Oxiderade guldpläterade kontaktstift gör att spelen inte startar. Vi djuprengör med isopropanol så spelet bootar klockrent på första försöket.
              </p>
            </div>

            <div class="service-card">
              <p class="service-name">PCB &amp; Trace Repair</p>
              <span class="service-price">Efter felsökning</span>
              <p class="service-desc">
                Åtgärdande av spruckna lödpunkter, trasiga banor orsakade av batteriläckage och reparation av kassetter som annars hade betraktats som skrot.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Step by Step Process for Businesses -->
    <section class="process-section">
      <h2 class="section-title">Så enkelt fungerar det</h2>
      <div class="process-steps">
        <div class="process-step">
          <div class="step-num">1</div>
          <h4>Kontakta oss</h4>
          <p>Fyll i formuläret nedan, skicka ett SMS eller maila oss med uppskattat antal enheter och vad som strular.</p>
        </div>
        <div class="process-step">
          <div class="step-num">2</div>
          <h4>Få offert med bulkpris</h4>
          <p>Inom 24 timmar får ni en tydlig, fast offert med specificerat styckpris och beräknad tidsåtgång.</p>
        </div>
        <div class="process-step">
          <div class="step-num">3</div>
          <h4>Skicka eller lämna in</h4>
          <p>Packa en samlingslåda och posta via PostNord Företagspaket, eller lämna in direkt i Malmö-verkstan.</p>
        </div>
        <div class="process-step">
          <div class="step-num">4</div>
          <h4>Proffsreparation &amp; Test</h4>
          <p>Vi löder, byter komponenter och hårdtestar alla enheter. Vi dokumenterar arbetet noggrant.</p>
        </div>
        <div class="process-step">
          <div class="step-num">5</div>
          <h4>Retur &amp; Faktura</h4>
          <p>Vi returnerar era servade enheter i säkert emballage tillsammans med specificerad momsfaktura och 6 mån garanti.</p>
        </div>
      </div>
    </section>

    <!-- Direct Contact Options Banner -->
    <section class="direct-contact-banner">
      <div class="banner-text">
        <h3>Vill du bolla ett parti direkt över telefon eller SMS?</h3>
        <p>Vi vet att butiksägare ofta har fullt upp i kassan. Ring eller släng iväg ett snabbt SMS med vad ni har, så svarar vi direkt!</p>
      </div>
      <div class="banner-buttons">
        <a href="sms:+46790320605" class="banner-btn sms-btn">💬 SMS:A 079-032 06 05</a>
        <a href="tel:0790320605" class="banner-btn call-btn">📞 RING 079-032 06 05</a>
      </div>
    </section>

    <!-- B2B Booking / Inquiry Form -->
    <section id="kontakt-form" class="contact-card b2b-form-card">
      <div class="form-header">
        <span class="trust-badge">OFFERTFÖRFRÅGAN FÖRETAG</span>
        <h2>Begär prisförslag &amp; offert för ert parti</h2>
        <p>Fyll i era uppgifter så återkommer vi med ett förmånligt bulkpris. Ingen förfrågan är bindande!</p>
      </div>

      <form id="b2b-contact-form" class="contact-form" method="POST" enctype="multipart/form-data">
        <div class="form-row-2">
          <div class="form-group">
            <label for="company-name">Företagsnamn / Butik *</label>
            <input type="text" id="company-name" name="fi-company-name" placeholder="T.ex. Spelgalaxen AB, Retrobutiken..." required>
          </div>
          <div class="form-group">
            <label for="contact-person">Kontaktperson *</label>
            <input type="text" id="contact-person" name="fi-sender-firstName" placeholder="För- och efternamn" required>
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label for="contact-email">E-postadress *</label>
            <input type="email" id="contact-email" name="fi-sender-email" placeholder="namn@foretag.se" required>
          </div>
          <div class="form-group">
            <label for="contact-phone">Telefonnummer (för SMS/samtal) *</label>
            <input type="tel" id="contact-phone" name="fi-sender-phone" placeholder="070-123 45 67" required>
          </div>
        </div>

        <div class="form-row-2">
          <div class="form-group">
            <label for="preferred-contact">Hur vill du helst bli kontaktad?</label>
            <select id="preferred-contact" name="fi-text-contact-me" required>
              <option value="sms" selected>SMS (Snabbast &amp; smidigast)</option>
              <option value="email">E-post</option>
              <option value="call">Telefonsamtal</option>
            </select>
          </div>
          <div class="form-group">
            <label for="device-type">Vilken typ av enheter gäller det?</label>
            <select id="device-type" name="fi-text-enhet" required>
              <option value="kontroller-bulk">Handkontroller (PS1–PS5, Xbox, Switch m.fl.)</option>
              <option value="konsoler-bulk">Konsoler (Laserbyten, Recap, Rengöring)</option>
              <option value="cartridges-bulk">Spelkassetter / Cartridges (Batteribyte Pokémon m.fl.)</option>
              <option value="blandat-parti">Blandat parti (Både kontroller, konsoler och spel)</option>
              <option value="ovrigt-b2b">Övrig elektronik / Specialmoddar</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label for="quantity">Uppskattat antal enheter:</label>
          <select id="quantity" name="fi-text-quantity" required>
            <option value="5-9">5 – 9 st </option>
            <option value="10-24" selected>10 – 24 st </option>
            <option value="25-50">25 – 50 st </option>
            <option value="50+">50+ st</option>
          </select>
        </div>

        <div class="form-group">
          <label for="message">Beskrivning av partiet &amp; felen:</label>
          <textarea 
            id="message" 
            name="fi-text-message" 
            rows="5" 
            placeholder="T.ex: Vi har ca 12 st PS4 och PS5 kontroller med stick drift samt 8 st Pokémon-spel (GBA/GBC) som behöver nya batterier. Önskar offert och estimerad ledtid." 
            required
          ></textarea>
        </div>

        <div class="form-group file-upload">
          <label for="photo">Bifoga bild eller packlista (valfritt):</label>
          <input type="file" id="photo" name="fi-file-photo" accept="image/*,.pdf,.xlsx,.csv">
        </div>

        <button type="submit" class="submit-btn b2b-submit-btn">SKICKA BULK-FÖRFRÅGAN</button>
      </form>

      <div id="result" style="margin-top: 1.5rem; color: var(--accent); font-weight: bold; text-align: center;"></div>
    </section>

    <!-- FAQ Section -->
    <section class="faq-section">
      <h2 class="section-title">Vanliga frågor från butiker &amp; företag</h2>
      
      <div class="faq-grid">
        <div class="faq-item">
          <h4>Hur skiljer sig era reparationer från att byta med billiga delar?</h4>
          <p>
            Vi använder uteslutande premiumdelar som testas grundligt. För handkontroller monterar vi magnetiska TMR-sensorer eller äkta Alps-potentiometrar med fabrikskalibrering. För cartridges använder vi kvalitetsbatterier med fasta stift som inte lossnar eller skadar kretskortet. Det innebär inga arga returer i er butik.
          </p>
        </div>

        <div class="faq-item">
          <h4>Hur packar och skickar vi bäst till er?</h4>
          <p>
            Använd en rejäl kartong och bubbelplast runt varje enhet eller mellan lagren. Lägg gärna med en enkel följesedel med ert företagsnamn och kontaktuppgifter. Skicka med PostNord Företagspaket eller Spårbart Paket direkt till vår verkstadsadress i Malmö.
          </p>
        </div>

