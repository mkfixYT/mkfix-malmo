  <!-- Forminit Script for B2B Submissions -->
  <script src="https://forminit.com/sdk/v1/forminit.js"></script>
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      const forminit = new Forminit();
      const FORM_ID = "7b7ffs280f3";
      const formElement = document.getElementById("b2b-contact-form");

      if (formElement) {
        formElement.addEventListener("submit", async (e) => {
          e.preventDefault();
          const result = document.getElementById("result");
          if (result) {
            result.textContent = "Skickar din offertförfrågan...";
            result.style.color = "var(--accent)";
          }

          const formData = new FormData(e.target);
          const { data, error } = await forminit.submit(FORM_ID, formData);

          if (error) {
            if (result) {
              result.textContent = "Något gick fel vid inskickning: " + error.message + ". Vänligen kontakta oss direkt via SMS eller telefon på 079-032 06 05.";
              result.style.color = "#ef4444";
            }
            return;
          }

          window.location.href = "/tack";
        });
      }
    });
  </script>

