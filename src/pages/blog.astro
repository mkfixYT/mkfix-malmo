---
// src/pages/blog.astro
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { posts } from "../data/posts";

const sortedPosts = [...posts].sort(
  (a, b) =>
    Date.parse(b.pubDate || "") -
    Date.parse(a.pubDate || ""),
);
---

<MainLayout
  title="mkFix Case Studies & Nyheter | Verkstadsblogg"
  description="Häng med bakom kulisserna i mkFix-verkstaden i Malmö. Här delar vi med oss av kontroller-lagningar, TMR-uppgraderingar och guider."
  canonicalUrl="https://mkfix.se/blog/"
>
  <Header />
  <main class="container">
    <section class="hero">
      <h1>mkFix <span>Case Studies</span> &amp; Nyheter</h1>
      <p>
        Häng med bakom kulisserna i verkstaden. Här delar vi med oss av
        lagningar, uppgraderingar och guider.
      </p>
    </section>

    <div
      class="filter-container"
      style="text-align: center; margin-bottom: 3rem;"
    >
      <button class="filter-btn active" data-filter="all">Visa alla</button>
      <button class="filter-btn" data-filter="tmr">TMR Uppgradering</button>
      <button class="filter-btn" data-filter="retro">Retro-fix</button>
      <button class="filter-btn" data-filter="guide">Guider</button>
      <button class="filter-btn" data-filter="tips">Tips</button>
    </div>

    <div class="grid" id="blog-grid">
      {
        sortedPosts.map((post) => {
          const postUrl = `/blog/${post.slug}/`;

          return (
            <article class="card post-card" data-category={post.categories || ""}>
              {post.isLatest && <div class="popular-tag">Senaste</div>}

              <span
                class="price-badge"
                style="margin-bottom: 1rem; display: inline-block; width: fit-content"
              >
                {post.badge || "Case Study"}
              </span>

              <h3>{post.title || "Titel saknas"}</h3>
              <p>{post.description || "Beskrivning saknas..."}</p>
              <br />

              <a
                href={postUrl}
                class="nav-cta"
                style="display: inline-block; text-align: center; width: fit-content;"
              >
                Läs hela inlägget
              </a>
            </article>
          );
        })
      }
    </div>
  </main>
  <Footer />
</MainLayout>

<script is:inline>
  const filterButtons = document.querySelectorAll(".filter-btn");
  const postCards = document.querySelectorAll(".post-card");

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      filterButtons.forEach((btn) => btn.classList.remove("active"));
      button.classList.add("active");

      const filterValue = button.getAttribute("data-filter");

      postCards.forEach((card) => {
        const categories = card.getAttribute("data-category") || "";

        if (filterValue === "all" || categories.includes(filterValue)) {
          card.style.display = "block";
        } else {
          card.style.display = "none";
        }
      });
    });
  });
</script>
