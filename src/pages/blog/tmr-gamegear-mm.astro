---
import BlogLayout from "../../layouts/BlogLayout.astro";
import { Image } from "astro:assets";

import tmr1 from "../../assets/img/2026/0505/tmr 1.jpg";
import tmr2 from "../../assets/img/2026/0505/tmr 2.jpg";
import tmr3 from "../../assets/img/2026/0505/tmr 3.jpg";
import tmr4 from "../../assets/img/2026/0505/tmr 4.jpg";
import tmr5 from "../../assets/img/2026/0505/tmr 5.jpg";
import macImg from "../../assets/img/2026/0505/mac.jpg";
import gamecubeImg from "../../assets/img/2026/0505/gamecube.jpg";
import blurayImg from "../../assets/img/2026/0505/bluray.jpg";
import gamegear1 from "../../assets/img/2026/0505/gamegear1.jpg";
import gamegear2 from "../../assets/img/2026/0505/gamegear2.jpg";
import switch1 from "../../assets/img/2026/0505/switch1.jpg";
import switch2 from "../../assets/img/2026/0505/switch2.jpg";
import switch3 from "../../assets/img/2026/0505/switch3.jpg";

export const frontmatter = {
    title: "Case Study: TMR-sticks, game gear, game cube, mac, nintendo switch och blu ray | mkFix Malmö",
    description: "Se våra reparationer denna veckan!",
    ogTitle:
        "Case Study: TMR-sticks, game gear, game cube, mac, nintendo switch och blu ray | mkFix Malmö",
    ogDescription:
        "Vi visar hur vi räddar kontroller och konsoler i verkstaden. Kolla in TMR och switch reparationerna!",
    keywords:
        "TMR sticks case study, game gear recap, Nintendo switch laddar ej joycons, laga handkontroll Malmö, K-Silver TMR, blu ray reparation",
    canonicalUrl: "https://mkfix.se/blog/tmr-gamegear-mm/",
    badge: "Case study #2",
    categories: "case study, guider, tmr uppgradering",
    pubDate: "05 Maj, 2026",
    isLatest: false,
};
---

<BlogLayout frontmatter={frontmatter}>
    <div style="max-width: 800px; margin: 0 auto;">
        <p style="font-size: 1.2rem; margin-bottom: 2rem;">
            Nu har jag inte varit så superbra på att hålla bloggen uppdaterad
            ofta, men detta har hänt sedan sist!
        </p>

        <div class="card" style="margin-bottom: 3rem;">
            <h2 style="color: var(--accent);">🕹️ TMR-Uppgradering: K-Silver</h2>
            <p>
                Vi bytte ut slitna, driftande joysticks till splitternya <strong
                    >K-Silver TMR sticks</strong
                >. Det här är den ultimata lösningen för dig som vill slippa
                stick drift permanent! 🧲✨. Som ni ser så var det en del
                kontroller som blev fixade
            </p>
            <div
                style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 1.5rem;"
            >
                <div
                    style="background: var(--border); object-fit: cover; border-radius: 10px; display: flex; align-items: center; justify-content: center;"
                >
                    <Image
                        style="width: 100%; height: auto; object-fit: cover; border-radius: 10px;"
                        src={tmr1}
                        alt="Gammla joysticks och nya Malmö"
                    />
                </div>
                <div
                    style="background: var(--border); object-fit: cover; border-radius: 10px; display: flex; align-items: center; justify-content: center;"
                >
                    <Image
                        style="width: 100%; height: auto; object-fit: cover; border-radius: 10px;"
                        src={tmr2}
                        alt="TMR uppgradering Malmö"
                    />
                </div>
                <div
                    style="background: var(--border); object-fit: cover; border-radius: 10px; display: flex; align-items: center; justify-content: center;"
                >
                    <Image
                        style="width: 100%; height: auto; object-fit: cover; border-radius: 10px;"
                        src={tmr3}
                        alt="Två lagade playstation 5 kontroller Malmö"
                    />
                </div>
                <div
                    style="background: var(--border); object-fit: cover; border-radius: 10px; display: flex; align-items: center; justify-content: center;"
                >
                    <Image
                        style="width: 100%; height: auto; object-fit: cover; border-radius: 10px;"
                        src={tmr4}
                        alt="Tre lagade PS5 kontroller Malmö"
                    />
                </div>
                <div
                    style="background: var(--border); object-fit: cover; border-radius: 10px; display: flex; align-items: center; justify-content: center;"
                >
                    <Image
                        style="width: 100%; height: auto; object-fit: cover; border-radius: 10px;"
                        src={tmr5}
                        alt="Närbild nya TMR sticks Malmö"
                    />
                </div>
            </div>
        </div>

        <div class="card" style="margin-bottom: 3rem;">
            <h2 style="color: var(--accent);">Mac som inte startade</h2>
            <p>
                Vi gav oss på en lite äldre macbook air som inte alls ville
                starta, visade sig vara touchpaden som spökade och nu är den
                tillbaka till sitt vanliga jag.
            </p>
            <div
                style="background: var(--border); width: 100%; aspect-ratio: 16/9; border-radius: 10px; margin-top: 1.5rem; display: flex; align-items: center; justify-content: center;"
            >
                <Image
                    style="width:100%; height: 100%; object-fit: cover; border-radius: 10px;"
                    src={macImg}
                    alt="Reparation av Macbook air Malmö"
                />
            </div>
        </div>

        <div class="card" style="margin-bottom: 3rem;">
            <h2 style="color: var(--accent);">Glömst Nintendo Gamecube</h2>
            <p>
                Denna Nintendo Gamecube glömde hela tiden sina inställningar.
                Visade sig att den behövde ett nytt batteri och nu kommer den
                ihåg allt!
            </p>
            <div
                style="background: var(--border); width: 100%; aspect-ratio: 16/9; border-radius: 10px; margin-top: 1.5rem; display: flex; align-items: center; justify-content: center;"
            >
                <Image
                    style="width:100%; height: 100%; object-fit: cover; border-radius: 10px;"
                    src={gamecubeImg}
                    alt="Reparation av Nintendo Game cube Malmö"
                />
            </div>
        </div>

        <div class="card" style="margin-bottom: 3rem;">
            <h2 style="color: var(--accent);">
                Blu ray spelare med dålig lucka
            </h2>
            <p>
                En blu ray spelare som inte kan öppna sin lucka är inget att ha.
                Vi fixade den genom att ersätta ett gummiband vid motorn samt ge
                den nytt plastfett.
            </p>
            <div
                style="background: var(--border); width: 100%; aspect-ratio: 16/9; border-radius: 10px; margin-top: 1.5rem; display: flex; align-items: center; justify-content: center;"
            >
                <Image
                    style="width:100%; height: 100%; object-fit: cover; border-radius: 10px;"
                    src={blurayImg}
                    alt="Reparation av Blu ray spelare Malmö"
                />
            </div>
        </div>

        <div class="card" style="margin-bottom: 3rem;">
            <h2 style="color: var(--accent);">🕹️ Fishy Sega Game gear!</h2>
            <p>
                Detta var ett projekt. En Game gear som hade kommit in.
                Problemet? Samma som vanligt. Alla kondensatorer hade läckt och
                luktade fisk, skärmen startade inte alls. Vi tog av dem gamla,
                rensade kretskortet som lyckligtvis nog inte hade blivit skadat
                och installerade nya kondensatorer. Nu funkar den exakt som ny!
            </p>
            <div
                style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 1.5rem;"
            >
                <div
                    style="background: var(--border); object-fit: cover; border-radius: 10px; display: flex; align-items: center; justify-content: center;"
                >
                    <Image
                        style="width: 100%; height: auto; object-fit: cover; border-radius: 10px;"
                        src={gamegear1}
                        alt="Game gear som inte fungerade Malmö"
                    />
                </div>
                <div
                    style="background: var(--border); object-fit: cover; border-radius: 10px; display: flex; align-items: center; justify-content: center;"
                >
                    <Image
                        style="width: 100%; height: auto; object-fit: cover; border-radius: 10px;"
                        src={gamegear2}
                        alt="Gamegear fungerar igen Malmö"
                    />
                </div>
            </div>
        </div>

        <div class="card" style="margin-bottom: 3rem;">
            <h2 style="color: var(--accent);">
                🕹️ Nintendo switch som inte laddade joycons
            </h2>
            <p>
                Visade sig att en diod hade dött och blev ersatt. Kunden ville
                också ha service så den fick konsolen rengjord samt ny
                kylarpasta.
            </p>
            <div
                style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 1.5rem;"
            >
                <div
                    style="background: var(--border); object-fit: cover; border-radius: 10px; display: flex; align-items: center; justify-content: center;"
                >
                    <Image
                        style="width: 100%; height: auto; border-radius: 10px;"
                        src={switch1}
                        alt="Gammal kylarpasta Malmö"
                    />
                </div>
                <div
                    style="background: var(--border); object-fit: cover; border-radius: 10px; display: flex; align-items: center; justify-content: center;"
                >
                    <Image
                        style="width: 100%; height: auto; object-fit: cover; border-radius: 10px;"
                        src={switch2}
                        alt="nintendo switch reparation Malmö"
                    />
                </div>
                <div
                    style="background: var(--border); object-fit: cover; border-radius: 10px; display: flex; align-items: center; justify-content: center;"
                >
                    <Image
                        style="width: 100%; height: auto; object-fit: cover; border-radius: 10px;"
                        src={switch3}
                        alt="Nintendo switch ny kylarpasta Malmö"
                    />
                </div>
            </div>
        </div>
    </div>
</BlogLayout>
