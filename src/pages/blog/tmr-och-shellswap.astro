---
import BlogLayout from "../../layouts/BlogLayout.astro";

export const frontmatter = {
    title: "Case Study: TMR-sticks & Nintendo DS Renovering | mkFix Malmö",
    description:
        "Se hur vi åtgärdade stick drift permanent med K-Silver TMR-sticks och utförde ett komplett skärm- och skalbyte på en klassisk Nintendo DS. Läs vår case study!",
    ogTitle: "Case Study: Från Stick Drift till TMR-precision | mkFix",
    ogDescription:
        "Vi visar hur vi räddar kontroller och konsoler i verkstaden. Kolla in gårdagens jobb på TMR-sticks och Nintendo DS!",
    keywords:
        "TMR sticks case study, Nintendo DS skärmbyte, Nintendo DS shell swap, laga handkontroll Malmö, K-Silver TMR, reparera Nintendo DS",
    canonicalUrl: "https://mkfix.se/blog/tmr-och-shellswap",
    badge: "Case study #1",
    categories: "case study",
    pubDate: "01 April, 2026",
    isLatest: false,
};
---

<BlogLayout frontmatter={frontmatter}>
    <div style="max-width: 800px; margin: 0 auto;">
        <p style="font-size: 1.2rem; margin-bottom: 2rem;">
            Igår var en produktiv dag i verkstaden! Vi fick in både moderna
            pro-kontroller och en riktig Nintendo-klassiker för lite välbehövlig
            kärlek.
        </p>

        <div class="card" style="margin-bottom: 3rem;">
            <h2 style="color: var(--accent);">🕹️ TMR-Uppgradering: K-Silver</h2>
            <p>
                Vi bytte ut slitna, driftande joysticks till splitternya <strong
                    >K-Silver TMR sticks</strong
                >. Det här är den ultimata lösningen för dig som vill slippa
                stick drift permanent! 🧲✨
            </p>
            <div
                style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 1.5rem;"
            >
                <div
                    style="background: var(--border); aspect-ratio: 1; border-radius: 10px; display: flex; align-items: center; justify-content: center;"
                >
                    <img
                        style="width: 100%; aspect-ratio: 1; border-radius: 10px;"
                        src="/img/2026/0405/joystick swap.webp"
                        alt="kontrollreparation Malmö"
                    />
                </div>
                <div
                    style="background: var(--border); aspect-ratio: 1; border-radius: 10px; display: flex; align-items: center; justify-content: center;"
                >
                    <img
                        style="width: 100%; aspect-ratio: 1; border-radius: 10px;"
                        src="/img/2026/0405/tmr upgradering.webp"
                        alt="TMR uppgradering Malmö"
                    />
                </div>
            </div>
        </div>

        <div class="card" style="margin-bottom: 3rem;">
            <h2 style="color: var(--accent);">
                👾 Nintendo DS: Skärmbyte & Shell Swap
            </h2>
            <p>
                Vi gav också en klassisk Nintendo DS nytt liv med en ny skärm
                och en fräsch "shell swap". Det är alltid tillfredsställande att
                se en gammal trotjänare se ut som ny igen. Blev ganska snyggt,
                eller vad tycker ni? 💎
            </p>
            <div
                style="background: var(--border); width: 100%; aspect-ratio: 16/9; border-radius: 10px; margin-top: 1.5rem; display: flex; align-items: center; justify-content: center;"
            >
                <img
                    style="width:100%; border-radius: 10px;"
                    src="/img/2026/0405/skalbyte.jpg"
                    alt="Reparation av Nintendo DS Malmö"
                />
            </div>
        </div>
    </div>
</BlogLayout>
