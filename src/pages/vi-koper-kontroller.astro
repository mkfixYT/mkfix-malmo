---
// src/pages/vi-koper-kontroller.astro
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { buybackItems, buybackCategories, buybackFaq } from "../data/buybackPrices";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Inköp & Inbyte av Handkontroller",
  "serviceType": "Inköp och återbruk av spelkontroller och elektronik",
  "description": "Sälj dina begagnade, slitna eller defekta handkontroller (PS5, Xbox, Nintendo Switch, Scuf & retro) till mkFix i Malmö eller via post. Få pengar på Swish eller extra inbytesrabatt i butiken.",
  "provider": {
    "@type": "ElectronicsRepairShop",
    "name": "mkFix Malmö",
    "url": "https://mkfix.se",
    "telephone": "+46790320605"
  },
  "areaServed": [
    { "@type": "City", "name": "Malmö" },
    { "@type": "Country", "name": "Sverige" }
  ],
  "url": "https://mkfix.se/vi-koper-kontroller/"
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Hem",
      "item": "https://mkfix.se/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Vi köper dina kontroller",
      "item": "https://mkfix.se/vi-koper-kontroller/"
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": buybackFaq.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.answer
    }
  }))
};
---

<MainLayout
  title="Sälj Handkontroll (Defekt eller Hel) – Vi Köper Kontroller | mkFix"
  description="Sälj defekta eller fungerande kontroller till mkFix! Vi köper PS5, Xbox, Switch, Scuf & retro. Få pengar på Swish eller inbytesrabatt i Malmö & via post."
  keywords="sälja trasig ps5 kontroll, sälja defekt kontroll, köper trasiga kontroller malmö, sälja scuf kontroll, pant handkontroll, inbyte handkontroller, stick drift inbyte, sälja xbox kontroll, sälja joy-con"
  canonicalUrl="https://mkfix.se/vi-koper-kontroller/"
  ogTitle="Sälj Din Handkontroll – Vi Köper Defekta & Fungerande | mkFix"
  ogDescription="Sälj dina kontroller till mkFix! Få snabb Swish-utbetalning eller extra rabatt på en ny TMR-kontroll. Lämna i Malmö eller skicka via PostNord."
  jsonLd={[serviceSchema, breadcrumbSchema, faqSchema]}
>
  <Header />

  <main class="container buyback-page">
    <!-- Hero Section -->
    <section class="hero buyback-hero">
      <div class="trust-box">
        <span class="trust-badge">♻️ CIRKULÄRT ÅTERBRUK</span>
        <span>Verkstad i Malmö &amp; PostNord från hela Sverige</span>
      </div>

      <h1>
        Vi köper dina handkontroller<br />
        <span>Defekta eller fungerande</span>
      </h1>

      <p class="buyback-lead">
        Har du handkontroller som ligger i en låda med <strong>stick drift</strong>, glappande knappar eller som bara samlar damm? 
        Kasta dem inte! Hos <strong>mkFix</strong> köper vi in dina kontroller och ger dem ett nytt liv med magnetiska TMR-sensorer. 
        Vi tar emot enheter <strong>lokalt i Malmö eller via post från hela Sverige</strong>. 
        Få <strong>snabba pengar på Swish</strong> eller <strong>extra inbytesrabatt</strong> på en ny TMR-kontroll i vår butik!
      </p>

      <!-- Trust Badges Bar -->
      <div class="buyback-perks">
        <div class="bb-perk">
          <span class="bb-perk-icon">⚡</span>
          <div>
            <strong>Snabb Swish</strong>
            <p>Pengar samma dag efter snabbt test</p>
          </div>
        </div>
        <div class="bb-perk">
          <span class="bb-perk-icon">🔄</span>
          <div>
            <strong>Extra Inbytesvärde</strong>
            <p>Få upp till 100 kr mer i rabatt i butiken</p>
          </div>
        </div>
        <div class="bb-perk">
          <span class="bb-perk-icon">📦</span>
          <div>
            <strong>Malmö eller PostNord</strong>
            <p>Lämna lokalt eller skicka från hela landet</p>
          </div>
        </div>
        <div class="bb-perk">
          <span class="bb-perk-icon">🌱</span>
          <div>
            <strong>Minska E-skrot</strong>
            <p>Hållbar renovering med precision</p>
          </div>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="hero-actions">
        <a href="#prislista" class="btn-primary">SE PRISLISTAN NEDAN ↓</a>
        <a href="sms:+46790320605?body=Hej%20mkFix!%20Jag%20vill%20s%C3%A4lja%20en%20handkontroll:%20" class="btn-secondary">
          💬 SMS:A BILD TILL 079-032 06 05
        </a>
      </div>
    </section>

    <!-- Trade-In Promo Callout -->
    <section class="trade-in-callout">
      <div class="callout-badge">💡 PRO-TIPS FÖR GAMERS</div>
      <div class="callout-body">
        <div class="callout-text">
          <h3>Vill du uppgradera till en TMR-kontroll som aldrig drifter?</h3>
          <p>
            Välj <strong>Inbytesrabatt</strong>! När du byter in din gamla/defekta kontroll mot en handbyggd TMR-moddad enhet i vår <a href="/produkter">butik</a> får du <strong>högre ersättning</strong> än vid ren kontantutbetalning. Ett perfekt sätt att förvandla trasigt skrot till en pro-kontroll för en bråkdel av nypriset!
          </p>
        </div>
        <a href="/produkter" class="callout-btn">TILL BUTIKEN →</a>
      </div>
    </section>

    <!-- How It Works Section -->
    <section class="how-it-works-section">
      <h2 class="section-title">Så enkelt säljer du <span>på 3 steg</span></h2>
      <div class="steps-grid">
        <div class="step-card">
          <div class="step-num">1</div>
          <h3>Kolla pris &amp; fota</h3>
          <p>Kolla i prislistan nedan vad din modell ger. Ta ett snabbt foto på kontrollen och skicka till oss på SMS eller formulär så bekräftar vi priset direkt.</p>
        </div>
        <div class="step-card">
          <div class="step-num">2</div>
          <h3>Lämna eller skicka</h3>
          <p>Lämna in kontrollen smidigt hos oss i Malmö eller skicka den med PostNord (spårbart Skicka Lätt). Säljer du 3+ enheter eller byter in mot en ny kontroll subventionerar vi frakten! <a href="/tjanster/skicka-in" style="color: var(--accent); font-weight: 700; display: block; margin-top: 6px;">Läs mer om hur du skickar in →</a></p>
        </div>
        <div class="step-card">
          <div class="step-num">3</div>
          <h3>Pengar på Swish</h3>
          <p>Vi funktionstestar kontrollen i testbänk och swishar överenskommen summa samma dag – eller ger dig en rabattkod att använda i butiken!</p>
        </div>
      </div>
    </section>

    <!-- Repair vs Sell bridge callout -->
    <div class="repair-bridge-card">
      <div class="bridge-content">
        <span class="bridge-icon">🛠️</span>
        <div class="bridge-text">
          <h4>Vill du hellre behålla och laga din kontroll?</h4>
          <p>
            Älskar du din handkontroll och vill ha den som ny igen? Vi byter ut slitna potentiometrar mot permanenta elektromagnetiska <strong>TMR-joysticks</strong> med 6 månaders garanti!
          </p>
        </div>
      </div>
      <a href="/#tjanster" class="bridge-btn">SE REPARATIONSPRISER →</a>
    </div>

    <!-- Price Table & Filter Section -->
    <section class="pricing-section" id="prislista">
      <div class="pricing-header">
        <h2 class="section-title">Prislista – <span>Vad betalar vi?</span></h2>
        <p class="pricing-subtitle">
          Priserna nedan är vägledande riktpriser för originalkontroller. Slutligt pris bekräftas när vi sett bild eller testat enheten.
        </p>
      </div>

      <!-- Category Filter Tabs -->
      <div class="category-filter-bar">
        <button class="filter-btn active" data-filter="all">Alla modeller</button>
        {buybackCategories.map((cat) => (
          <button class="filter-btn" data-filter={cat.id}>
            <span>{cat.icon}</span> {cat.label}
          </button>
        ))}
      </div>

      <!-- Pricing Cards Grid -->
      <div class="price-cards-grid" id="pricing-grid">
        {buybackItems.map((item) => (
          <div class={`buyback-card ${item.id === 'other' ? 'is-other' : ''}`} data-category={item.category}>
            {item.popular && <span class="card-pop-tag">🔥 Mycket efterfrågad</span>}
            {item.id === 'other' && <span class="card-other-tag">💬 Diskutera pris</span>}
            <div class="card-top">
              <span class="card-icon">{item.icon}</span>
              <div class="card-title-group">
                <span class="platform-pill">{item.platform}</span>
                <h3>{item.model}</h3>
              </div>
            </div>

            <div class="prices-comparison">
              <!-- Defekt Box -->
              <div class="price-box box-broken">
                <div class="box-label">
                  <span>Defekt</span>
                  <small>(Stick drift / sliten)</small>
                </div>
                <div class="box-amount">
                  {item.brokenPrice === '?' || item.brokenPrice === 0 ? (
                    <span class="price-question">?</span>
                  ) : (
                    <>{item.brokenPrice} <span>kr</span></>
                  )}
                </div>
                <span class="box-payout">{item.id === 'other' ? 'Diskuteras' : 'Kontant / Swish'}</span>
              </div>

              <!-- Fungerande Box -->
              <div class="price-box box-working">
                <div class="box-label">
                  <span>Fungerande</span>
                  <small>(Bra bruksskick)</small>
                </div>
                <div class="box-amount">
                  {item.workingPrice === '?' || item.workingPrice === 0 ? (
                    <span class="price-question">?</span>
                  ) : (
                    <>{item.workingPrice} <span>kr</span></>
                  )}
                </div>
                <span class="box-payout">{item.id === 'other' ? 'Diskuteras' : 'Kontant / Swish'}</span>
              </div>

              <!-- Trade-in Box (Highlighted) -->
              <div class="price-box box-tradein">
                <div class="box-label">
                  <span>Inbytesvärde</span>
                  <small>(I mkFix butik)</small>
                </div>
                <div class="box-amount">
                  {item.tradeInValue === '?' || item.tradeInValue === 0 ? (
                    <span class="price-question">?</span>
                  ) : (
                    <>{item.tradeInValue} <span>kr</span></>
                  )}
                </div>
                <span class="box-payout">{item.id === 'other' ? 'Diskuteras' : 'Rabatt vid köp!'}</span>
              </div>
            </div>

           {item.notes && <p class="card-notes">
              ℹ️ {item.notes}
            </p>}

            <div class="card-action">
              {item.id === 'other' ? (
                <a 
                  href="sms:+46790320605?body=Hej%20mkFix!%20Jag%20har%20en%20enhet%20jag%20vill%20s%C3%A4lja/diskutera%20pris%20p%C3%A5:%20"
                  class="card-sms-btn other-sms-btn"
                >
                  💬 KONTAKTA OSS FÖR PRISFÖRSLAG →
                </a>
              ) : (
                <a 
                  href={`sms:+46790320605?body=Hej%20mkFix!%20Jag%20vill%20s%C3%A4lja%20min%20${encodeURIComponent(item.model)}.%20Skick:%20`}
                  class="card-sms-btn"
                >
                  SÄLJ DENNA MODELL (SMS) →
                </a>
              )}
            </div>
          </div>
        ))}
      </div>

      <div class="custom-offer-box">
        <div class="custom-offer-content">
          <h4>Hittar du inte din kontroll i listan? Eller har du en hel låda / samling?</h4>
          <p>Vi köper även andra modeller, retrokonsoler och udda handkontroller. Kontakta oss med vad du har så ger vi ett snabbt prisförslag!</p>
        </div>
        <a href="tel:0790320605" class="custom-offer-btn">RING 079-032 06 05</a>
      </div>
    </section>

    <!-- Conditions: What We Accept vs What We Don't -->
    <section class="conditions-section">
      <h2 class="section-title">Vilka kontroller <span>tar vi emot?</span></h2>
      <div class="conditions-grid">
        <div class="condition-box accept">
          <div class="cond-header">
            <span class="cond-icon">✅</span>
            <h3>Det här köper vi gärna:</h3>
          </div>
          <ul>
            <li><strong>Originalkontroller:</strong> Äkta Sony, Microsoft, Nintendo eller officiellt licensierade pro-kontroller.</li>
            <li><strong>Stick drift:</strong> Kontroller där spakarna vandrar eller inte centrerar (perfekt för TMR-byte!).</li>
            <li><strong>Utslitna tumgrepp:</strong> Spakgummi som spruckit eller nötts ner.</li>
            <li><strong>Glappande knappar &amp; triggers:</strong> Defekta bumpers (RB/LB, R1/L1) eller fjädrar.</li>
            <li><strong>Kosmetiskt slitage:</strong> Mindre repor eller normalt spelarslitage är helt okej.</li>
            <li><strong>Fungerande enheter:</strong> Kontroller i toppskick ger högsta möjliga utbetalning.</li>
          </ul>
        </div>

        <div class="condition-box reject">
          <div class="cond-header">
            <span class="cond-icon">❌</span>
            <h3>Det här kan vi inte köpa (eller ger reservdelspris):</h3>
          </div>
          <ul>
            <li><strong>Piratkopior &amp; billiga kopior:</strong> Vi tar inte emot oäkta kontroller från Wish/Temu eller lågpriskloner.</li>
            <li><strong>Svåra vätskeskador:</strong> Kontroller dränkta i kaffe, läsk, öl eller fuktskadade moderkort.</li>
            <li><strong>Misslyckade lödningsförsök:</strong> Om kretskortet är sönderbränt av hemmalödning eller banor slitits loss.</li>
            <li><strong>Knäckta / krossade skal och kretskort:</strong> Enheter som blivit fysiskt förstörda genom våld.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Contact & Valuation Form Box -->
    <section class="contact-valuation-box" id="salj-kontakt">
      <div class="cv-header">
        <span class="trust-badge">FÅ PRISFÖRSLAG DIREKT</span>
        <h2>Redo att sälja? Hör av dig på det sätt som passar dig bäst!</h2>
        <p>Skicka ett foto på fram- och baksida så bekräftar vi priset inom kort.</p>
      </div>

      <div class="cv-grid">
        <a href="sms:+46790320605?body=Hej%20mkFix!%20Jag%20har%20en%20kontroll%20jag%20vill%20s%C3%A4lja.%20Modell:%20" class="cv-card sms">
          <span class="cv-icon">💬</span>
          <div class="cv-details">
            <h3>SMS:a oss direkt (Snabbast)</h3>
            <p>Skicka bild &amp; beskrivning till <strong>079-032 06 05</strong>. Vi svarar ofta inom någon timme!</p>
            <span class="cv-action-text">Klicka för att öppna SMS →</span>
          </div>
        </a>

        <a href="#mail-formular" class="cv-card email">
          <span class="cv-icon">✉️</span>
          <div class="cv-details">
            <h3>Maila formulär</h3>
            <p>Använd vårt enkla mailformulär nedan eller skriv till <strong>kontakt@mkfix.se</strong>.</p>
            <span class="cv-action-text">Gå till mailformuläret ↓</span>
          </div>
        </a>

        <a href="tel:0790320605" class="cv-card phone">
          <span class="cv-icon">📞</span>
          <div class="cv-details">
            <h3>Ring verkstan</h3>
            <p>Fråga oss direkt över telefon: <strong>079-032 06 05</strong>. Öppet alla vardagar.</p>
            <span class="cv-action-text">Ring 079-032 06 05 →</span>
          </div>
        </a>

        <a href="https://discord.gg/s75Kww368a" target="_blank" class="cv-card discord">
          <span class="cv-icon">🎮</span>
          <div class="cv-details">
            <h3>Häng i vår Discord</h3>
            <p>Skicka ett PM eller ställ frågor i vår aktiva gaming-community.</p>
            <span class="cv-action-text">Öppna mkFix Discord →</span>
          </div>
        </a>
      </div>

      <!-- Inbyggt Mail- & Värderingsformulär -->
      <div class="mail-form-container" id="mail-formular">
        <div class="form-title-group">
          <span class="form-badge">✉️ MAILFORMULÄR</span>
          <h3>Skicka din inbytes- &amp; säljförfrågan via mail</h3>
          <p>Fyll i formuläret så återkommer vi snabbt med ett prisförslag och instruktioner för inlämning eller frakt.</p>
        </div>

        <form id="buyback-mail-form" class="buyback-form" method="POST" enctype="multipart/form-data">
          <div class="form-row-2">
            <div class="form-group">
              <label for="bb-name">Ditt namn *</label>
              <input type="text" id="bb-name" name="fi-sender-firstName" placeholder="För- och efternamn" autocomplete="name" required />
            </div>
            <div class="form-group">
              <label for="bb-email">Din e-postadress *</label>
              <input type="email" id="bb-email" name="fi-sender-email" placeholder="din@epost.se" autocomplete="email" required />
            </div>
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label for="bb-phone">Telefonnummer (valfritt för SMS/Swish)</label>
              <input type="tel" id="bb-phone" name="fi-sender-phone" placeholder="070-123 45 67 eller +46..." autocomplete="tel" />
            </div>
            <div class="form-group">
              <label for="bb-model">Vilken kontroll / modell gäller det? *</label>
              <select id="bb-model" name="fi-text-enhet" required>
                <option value="" disabled selected>Välj modell...</option>
                <option value="ps5-dualsense">PlayStation 5 DualSense</option>
                <option value="ps5-edge">PlayStation 5 DualSense Edge</option>
                <option value="xbox-series">Xbox Series X/S (Modell 1914)</option>
                <option value="xbox-one">Xbox One (Modell 1708)</option>
                <option value="xbox-elite-2">Xbox Elite Series 2</option>
                <option value="xbox-elite-1">Xbox Elite Series 1</option>
                <option value="switch-joycon">Nintendo Switch Joy-Cons (Par/Enkel)</option>
                <option value="switch-pro">Nintendo Switch Pro Controller</option>
                <option value="ps4-dualshock-4">PlayStation 4 DualShock 4</option>
                <option value="scuf-ps5">Scuf Reflex (PS5)</option>
                <option value="scuf-xbox">Scuf Instinct (Xbox)</option>
                <option value="aim-controllers">AimControllers (PS5 / Xbox)</option>
                <option value="scuf-aim-ps4">Scuf / Aim Pro (PS4)</option>
                <option value="retro-gamecube">Nintendo GameCube (Original)</option>
                <option value="retro-n64">Nintendo 64 (Original)</option>
                <option value="retro-ps2">PlayStation 2 DualShock 2</option>
                <option value="retro-xbox-360">Xbox 360 Trådlös</option>
                <option value="annat">Annat / Övriga enheter &amp; Samlingar</option>
              </select>
            </div>
          </div>

          <div class="form-row-2">
            <div class="form-group">
              <label for="bb-condition">Skick på enheten *</label>
              <select id="bb-condition" name="fi-text-skick" required>
                <option value="defekt-stickdrift" selected>Defekt: Stick drift (spakar vandrar)</option>
                <option value="defekt-knappar">Defekt: Knappar / bumpers / slitage</option>
                <option value="fungerande">Fullt fungerande (Bra bruksskick)</option>
                <option value="vet-ej">Vet ej / Blandat skick / Flera enheter</option>
              </select>
            </div>
            <div class="form-group">
              <label for="bb-preference">Vad önskar du? *</label>
              <select id="bb-preference" name="fi-text-onskan" required>
                <option value="swish" selected>Pengar via Swish</option>
                <option value="inbyte">Inbytesrabatt i butiken (TMR-kontroll)</option>
                <option value="diskutera">Vill diskutera prisförslag först</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label for="bb-message">Meddelande / Ytterligare information:</label>
            <textarea 
              id="bb-message" 
              name="fi-text-message" 
              rows="4" 
              placeholder="T.ex: Jag har en vit PS5-kontroll med stick drift och en defekt Xbox One-kontroll. Önskar byta in mot en renoverad TMR-kontroll."
            ></textarea>
          </div>

          <div class="form-group file-upload">
            <label for="bb-photo">Bifoga bild på kontrollen (valfritt, men rekommenderas):</label>
            <input type="file" id="bb-photo" name="fi-file-photo" accept="image/*" />
            <small class="file-hint">Bilder på fram- och baksida gör att vi kan ge ett exakt prisförslag direkt.</small>
          </div>

          <button type="submit" class="submit-btn buyback-submit-btn">SKICKA FÖRFRÅGAN VIA MAIL</button>
        </form>

        <div id="buyback-result" style="margin-top: 1.5rem; color: var(--accent); font-weight: bold; text-align: center;"></div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="buyback-faq-section">
      <h2 class="section-title">Vanliga frågor om <span>kontrollinköp</span></h2>
      <div class="faq-list">
        {buybackFaq.map((item) => (
          <details class="faq-item">
            <summary class="faq-summary">
              <span>{item.question}</span>
              <span class="faq-arrow">▼</span>
            </summary>
            <div class="faq-content">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer />

  <!-- Forminit Script for Buyback / Trade-In Inquiries -->
  <script src="https://forminit.com/sdk/v1/forminit.js"></script>

  <script is:inline>
    // Category Filter Logic
    function initCategoryFilter() {
      const filterBtns = document.querySelectorAll(".category-filter-bar .filter-btn");
      const cards = document.querySelectorAll(".buyback-card");

      filterBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          filterBtns.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");

          const filter = btn.getAttribute("data-filter");

          cards.forEach((card) => {
            const isOther = card.getAttribute("data-category") === "other";
            if (filter === "all" || card.getAttribute("data-category") === filter || isOther) {
              card.style.display = "flex";
            } else {
              card.style.display = "none";
            }
          });
        });
      });
    }

    function normalizePhone(raw) {
      if (!raw) return { e164: "", raw: "" };
      const trimmed = String(raw).trim();
      if (!trimmed) return { e164: "", raw: "" };

      let cleaned = trimmed;
      if (cleaned.startsWith("00")) {
        cleaned = "+" + cleaned.slice(2);
      }
      cleaned = cleaned.replace(/^\+46[\s\-\.]*\(?0\)?[\s\-\.]*/, "+46");

      let e164 = "";
      if (cleaned.startsWith("+")) {
        const digits = cleaned.slice(1).replace(/\D/g, "");
        if (digits.length >= 6 && digits.length <= 15) {
          e164 = "+" + digits;
        }
      } else {
        const digits = cleaned.replace(/\D/g, "");
        if (digits.startsWith("0")) {
          if (digits.length >= 7 && digits.length <= 11) {
            e164 = "+46" + digits.slice(1);
          }
        } else if (digits.startsWith("46") && digits.length >= 9 && digits.length <= 13) {
          if (digits.startsWith("460")) {
            e164 = "+46" + digits.slice(3);
          } else {
            e164 = "+" + digits;
          }
        } else if (digits.length === 9 && digits.startsWith("7")) {
          e164 = "+46" + digits;
        } else if (digits.length >= 7 && digits.length <= 15) {
          if (digits.length <= 9) {
            e164 = "+46" + digits;
          } else {
            e164 = "+" + digits;
          }
        }
      }

      const isValidE164 = /^\+[1-9]\d{6,14}$/.test(e164);
      return {
        e164: isValidE164 ? e164 : "",
        raw: trimmed
      };
    }

    function initBuybackForm() {
      const forminit = new Forminit();
      const FORM_ID = "7b7ffs280f3";
      const formElement = document.getElementById("buyback-mail-form");

      if (formElement) {
        formElement.addEventListener("submit", async (e) => {
          e.preventDefault();
          const result = document.getElementById("buyback-result");
          if (result) {
            result.textContent = "Skickar din förfrågan...";
            result.style.color = "var(--accent)";
          }

          const formData = new FormData(e.target);

          const rawPhone = formData.get("fi-sender-phone");
          if (rawPhone !== null && rawPhone !== undefined && String(rawPhone).trim() !== "") {
            const { e164, raw } = normalizePhone(rawPhone);
            if (raw) {
              formData.set("fi-text-telefon", raw);
            }
            if (e164) {
              formData.set("fi-sender-phone", e164);
            } else {
              formData.delete("fi-sender-phone");
            }
          } else {
            formData.delete("fi-sender-phone");
          }

          let res = await forminit.submit(FORM_ID, formData);

          if (res.error && (res.error.code === "FI_RULES_PHONE_INVALID" || (res.error.message && /phone/i.test(res.error.message)))) {
            formData.delete("fi-sender-phone");
            res = await forminit.submit(FORM_ID, formData);
          }

          if (res.error) {
            if (result) {
              result.textContent = "Något gick fel: " + res.error.message;
              result.style.color = "red";
            }
            return;
          }

          window.location.href = "/tack";
        });
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => {
        initCategoryFilter();
        initBuybackForm();
      });
