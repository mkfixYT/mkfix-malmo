---
// src/pages/tjanster/hdmi-port-byte.astro
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "HDMI-port Byte Spelkonsoler (PS5, PS4, Xbox Series, Xbox One) Malmö",
  "provider": {
    "@type": "ElectronicsRepairShop",
    "name": "mkFix",
    "url": "https://mkfix.se",
    "telephone": "+46790320605",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Malmö",
      "addressCountry": "SE"
    }
  },
  "areaServed": [
    { "@type": "City", "name": "Malmö" },
    { "@type": "Country", "name": "Sverige" }
  ],
  "description": "Professionellt byte av trasiga HDMI-portar på PlayStation 5, PlayStation 4, Xbox Series X/S, Xbox One och retrokonsoler med mikrolödning i Malmö. 6 månaders funktionsgaranti.",
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "SEK",
    "lowPrice": "499",
    "highPrice": "1199",
    "offerCount": "8"
  }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Vad kostar det att byta HDMI-port på min konsol?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ett HDMI-port byte kostar 1 199 kr för PlayStation 5, PlayStation 4, Xbox Series X/S samt Xbox One. För äldre konsoler som PS3 kostar det 999 kr, Xbox 360 / Wii U 899 kr, och för Nintendo Switch Dock 499 kr. Alla priser är fasta inklusive arbete, reservdel och 6 månaders garanti."
      }
    },
    {
      "@type": "Question",
      "name": "Hur lång tid tar ett HDMI-port byte?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Vi utför normalt HDMI-bytet inom 24 till 48 timmar efter att konsolen lämnats in i vår verkstad i Malmö. Skickar du in konsolen via PostNord returnerar vi den oftast 1-2 vardagar efter mottagandet."
      }
    },
    {
      "@type": "Question",
      "name": "Konsolen tappades i golvet med kabeln i – kan den fortfarande lagas?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja, absolut. När en konsol tappas eller kabeln rycks loss slits ibland kretskortets kopparbanor (lödpads) av. Vi är experter på mikrolödning och kan reparera och återskapa brutna ledningsbanor (trace repair / jumpers) så att signalen återställs helt."
      }
    },
    {
      "@type": "Question",
      "name": "Hur vet jag om det är HDMI-porten eller TV:n/kabeln som är trasig?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Börja med att prova en annan HDMI-kabel och en annan ingång på TV:n. Lyser konsolens statuslampa som vanligt (t.ex. vit lampa på PS5 och PS4) men skärmen visar 'Ingen signal', eller ser du böjda/saknade guldstift när du lyser in i porten, är det nästan garanterat HDMI-porten som behöver bytas."
      }
    },
    {
      "@type": "Question",
      "name": "Kan jag skicka in konsolen om jag inte bor i Malmö?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ja! Vi tar emot konsoler och kontroller via PostNord från hela Sverige varje vecka. Du packar konsolen väl och skickar in den spårbart, vi lagar den och skickar tillbaka den väl emballerad."
      }
    },
    {
      "@type": "Question",
      "name": "Ingår garanti på reparationen?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Självklart. Vi lämnar alltid 6 månaders full funktionsgaranti på såväl den nya HDMI-porten som själva lödarbetet."
      }
    }
  ]
};
---

<MainLayout
  title="HDMI-port Byte Spelkonsol Malmö | PS5, PS4, Xbox Series & One | mkFix"
  description="Trasig HDMI-port eller svart skärm? Vi byter HDMI-port på PlayStation 5, PS4, Xbox Series X/S, Xbox One med mikrolödning i Malmö. Fast pris 1 199 kr & 6 mån garanti."
  keywords="byta hdmi port ps5 malmö, hdmi reparation xbox series x, trasig hdmi playstation 4, laga hdmi port konsol, ingen signal ps5, ps5 vit lampa ingen bild, ps4 hdmi port byte pris, xbox one hdmi rep, mikrolödning hdmi malmö, mkfix"
