      </div>

      <!-- Xbox One -->
      <div class="card">
        <span class="service-tag time" style="margin-bottom: 0.8rem; display: inline-block;">Snabb service</span>
        <h3>Xbox One (Alla modeller)</h3>
        <p style="color: var(--text-dim); font-size: 0.95rem; margin-bottom: 1.2rem;">
          Gäller Xbox One Standard, Xbox One S och Xbox One X.
        </p>
        <ul style="list-style: none; padding: 0; margin-bottom: 1.5rem; font-size: 0.95rem;">
