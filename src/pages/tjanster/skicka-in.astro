---
// src/pages/tjanster/skicka-in.astro
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ProductPromo from "../../components/ProductPromo.astro";

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Skicka in konsol & handkontroll för lagning via PostNord",
  provider: {
    "@type": "ElectronicsRepairShop",
    name: "mkFix",
    url: "https://mkfix.se",
    telephone: "+46790320605",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Malmö",
      addressCountry: "SE",
    },
  },
  areaServed: [
    { "@type": "City", name: "Stockholm" },
    { "@type": "City", name: "Göteborg" },
    { "@type": "City", name: "Malmö" },
    { "@type": "City", name: "Uppsala" },
    { "@type": "Country", name: "Sverige" },
  ],
  description:
    "Reparation och uppgradering av spelkonsoler (PS5, Xbox, Switch) och handkontroller via spårbar postfrakt med PostNord från Stockholm, Göteborg och hela Sverige. Fasta priser och 6 månaders funktionsgaranti.",
  serviceType: "Electronics Repair & Mail-in Service",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Postorder reparationer",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "TMR Sensor Joystick Upgrade (PS5 & Xbox)",
        },
        price: "449",
        priceCurrency: "SEK",
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "HDMI-port Byte Konsol (PS5 & Xbox Series)",
        },
        price: "1199",
        priceCurrency: "SEK",
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Konsolrengöring & Liquid Metal / Kylpasta",
        },
        price: "649",
        priceCurrency: "SEK",
      },
    ],
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Kan jag skicka in min konsol eller kontroll från Stockholm eller Göteborg?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Ja, absolut! Över 60% av alla våra inlämningar kommer från kunder i Stockholm, Göteborg, Uppsala och resten av Sverige. PostNord levererar normalt inom 1–2 vardagar till vår verkstad. Vi utför lagningen snabbt (oftast inom 24–48 timmar) och returnerar spårbart till ditt närmaste ombud.",
      },
    },
    {
      "@type": "Question",
      name: "Vilken frakttjänst hos PostNord ska jag välja?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Vi rekommenderar 'PostNord Skicka Lätt' eller 'PostNord Paket' som du enkelt bokar och betalar i PostNord-appen eller på postnord.se. Båda alternativen är spårbara och försäkrade. För handkontroller kostar frakten oftast från ca 69–99 kr, och för spelkonsoler ca 135–179 kr.",
      },
    },
    {
      "@type": "Question",
      name: "Hur packar jag min enhet så att den inte skadas i transporten?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "För handkontroller: Använd alltid en liten, hård kartong med rikligt med bubbelplast runt om så att joysticks och spakar inte utsätts för tryck (skicka aldrig i enbart vadderat kuvert). För konsoler: Använd en rejäl kartong med minst 5 cm dämpande material (bubbelplast eller kraftpapper) runt hela chassit. Skicka endast själva enheten – inga lösa sladdar behövs.",
      },
    },
    {
      "@type": "Question",
      name: "Hur lång tid tar hela processen från att jag skickar tills jag får tillbaka den?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Normalt tar det 4–6 vardagar totalt: PostNord tar 1–2 vardagar ner till verkstaden, vi reparerar och testar inom 24–48 timmar, och därefter tar returfrakten 1–2 vardagar tillbaka till ditt ombud.",
      },
    },
    {
      "@type": "Question",
      name: "Hur betalar jag för reparationen och returfrakten?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Du betalar först när arbetet är färdigt och testat. Vi skickar en faktura eller Swish-betalningsunderlag tillsammans med kvitto och spårningsnummer för returpaketet. Faktisk returfrakt enligt PostNords prislista tillkommer.",
      },
    },
    {
      "@type": "Question",
      name: "Vad händer om min enhet visar sig vara omöjlig att laga?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Vi har kostnadsfri felsökning. Om felet mot förmodan inte går att åtgärda betalar du 0 kr för själva arbetet – endast den faktiska returfrakten om du vill ha enheten återsänd, eller så kan vi köpa in den som reservdelar om du önskar.",
      },
    },
  ],
};
---

<MainLayout
  title="Skicka in Konsol & Handkontroll för Lagning | PostNord Stockholm & Hela Sverige | mkFix"
  description="Bor du i Stockholm, Göteborg eller övriga Sverige? Skicka in din PS5, Xbox, Switch eller handkontroll via PostNord. Snabb service 24–48h, fasta priser och 6 månaders garanti!"
  keywords="skicka konsol på lagning, laga ps5 stockholm post, laga ps5 kontroll postnord, laga xbox stockholm, skicka handkontroll lagning göteborg, postnord skicka lätt konsol reparation, laga stick drift stockholm, ps5 hdmi reparation stockholm post, mkfix skicka in"
  ogTitle="Skicka in konsol & kontroll på lagning via PostNord | mkFix Sverige"
  ogDescription="Vi tar emot kontroller och konsoler från Stockholm, Göteborg och hela Sverige. Snabb turnaround, fast pris och 6 mån garanti."
  canonicalUrl="https://mkfix.se/tjanster/skicka-in/"
  jsonLd={[serviceSchema, faqSchema]}
>
  <Header />
  <main class="container">
    <!-- Hero Section -->
    <section class="hero">
      <div class="trust-box">
        <span class="trust-badge">POSTNORD HELA SVERIGE</span>
        <span>Spårbar frakt • 24–48h turnaround • 6 mån garanti</span>
      </div>
      <h1>Laga konsol &amp; handkontroll via <span>PostNord</span></h1>
      <p>
        Bor du i <strong>Stockholm, Göteborg, Uppsala</strong> eller någon annanstans
        i Sverige? Du behöver inte bo i Malmö för att få tillgång till professionell
        mikrolödning och permanenta
        <strong>TMR-uppgraderingar</strong>. Över 60% av våra kunder skickar in
        sina enheter spårbart via posten varje vecka.
      </p>

      <div
        class="hero-actions"
        style="display: flex; gap: 1rem; justify-content: center; align-items: center; flex-wrap: wrap; margin-top: 1.5rem;"
      >
        <a
          href="#boka-frakt"
          class="contact-method"
          style="font-size: 1.1rem; background: var(--accent); color: var(--bg); display: inline-block; padding: 14px 28px; border-radius: 10px; font-weight: 800; text-decoration: none;"
        >
          BOKA INSKICKNING HÄR ↓
        </a>
        <a
          href="#packguide"
          class="shop-hero-btn"
          style="font-size: 1rem; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.2); color: #fff; display: inline-flex; align-items: center; gap: 8px; padding: 14px 22px; border-radius: 10px; font-weight: 600; text-decoration: none;"
        >
          📦 Se Packguide &amp; Råd →
        </a>
      </div>
    </section>

    <!-- Regional Callout Banner (Stockholm & Västra Götaland Focus) -->
    <section
      style="background: linear-gradient(135deg, rgba(56, 189, 248, 0.12), rgba(30, 41, 59, 0.8)); border: 1px solid var(--accent); border-radius: 20px; padding: 2rem 2.5rem; margin: 2rem 0 4rem; box-shadow: 0 10px 30px rgba(0,0,0,0.3);"
    >
      <div
        style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem;"
      >
        <div style="max-width: 720px;">
          <span
            style="background: var(--accent); color: var(--bg); font-weight: 800; font-size: 0.8rem; padding: 4px 10px; border-radius: 6px; text-transform: uppercase;"
          >
            ⚡ SNABBT FRÅN STOCKHOLM &amp; GÖTEBORG
          </span>
          <h2 style="font-size: 1.6rem; margin: 0.8rem 0 0.5rem; color: #fff;">
            Bara 1–2 vardagars postgång från Stockholms län &amp; Västra
            Götaland
          </h2>
          <p
            style="color: var(--text-dim); margin-bottom: 0; font-size: 1rem; line-height: 1.6;"
          >
            Med <strong>PostNord Skicka Lätt</strong> har paketet ofta anlänt till
            verkstaden redan nästa vardag. Vi påbörjar felsökning eller lödning direkt
            vid ankomst, dokumenterar eller livestreamar reparationen på YouTube,
            och skickar tillbaka den väl emballerad till ditt lokala ombud. Hela processen
            tar oftast mindre än en vecka!
          </p>
        </div>
        <div style="text-align: center; min-width: 180px;">
          <div style="font-size: 2.5rem; font-weight: 900; color: #4ade80;">
            24–48h
          </div>
          <div
            style="color: var(--text-dim); font-size: 0.85rem; font-weight: 600;"
          >
            Verkstadstid i snitt
          </div>
        </div>
      </div>
    </section>

    <!-- 3-stegs guide -->
    <h2 class="section-title">Hur fungerar det? <span>3 enkla steg</span></h2>
    <div class="grid" style="margin-bottom: 4rem;">
      <div
        class="card"
        style="display: flex; flex-direction: column; justify-content: space-between;"
      >
        <div>
          <span class="price" style="font-size: 2.2rem; margin-bottom: 0.5rem;"
            >1</span
          >
          <h3>Boka &amp; få inlämningsadress</h3>
          <p style="margin-top: 0.8rem;">
            Fyll i formuläret längst ner på sidan eller skicka ett SMS till <a
              href="tel:0790320605"
              style="color: var(--accent); font-weight: 700;">079-032 06 05</a
            > med felet du upplever. Vi bekräftar fast pris och skickar verkstadens
            exakta leveransadress.
          </p>
        </div>
        <div
          style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.85rem; color: var(--accent);"
        >
          ✓ Alltid kostnadsfri konsultation
        </div>
      </div>

      <div
        class="card"
        style="display: flex; flex-direction: column; justify-content: space-between;"
      >
        <div>
          <span class="price" style="font-size: 2.2rem; margin-bottom: 0.5rem;"
            >2</span
          >
          <h3>Packa tryggt &amp; skicka spårbart</h3>
          <p style="margin-top: 0.8rem;">
            Vira in kontrollen eller konsolen i bubbelplast och lägg i en hård
            kartong. Köp en fraktsedel via <strong>PostNord Skicka Lätt</strong> (från
            69 kr) och lämna in hos ditt närmaste postombud.
          </p>
        </div>
        <div
          style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.85rem; color: var(--accent);"
        >
          ✓ Full spårbarhet via PostNord-appen
        </div>
      </div>

      <div
        class="card"
        style="display: flex; flex-direction: column; justify-content: space-between;"
      >
        <div>
          <span class="price" style="font-size: 2.2rem; margin-bottom: 0.5rem;"
            >3</span
          >
          <h3>Vi lagar, testar &amp; returnerar</h3>
          <p style="margin-top: 0.8rem;">
            Vi reparerar enheten i vår verkstad, genomför full funktionstestning
            och skickar tillbaka den tryggt packad. Du betalar smidigt med Swish
            eller faktura efter godkänd reparation!
          </p>
        </div>
        <div
          style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border); font-size: 0.85rem; color: var(--accent);"
        >
          ✓ 6 månaders garanti på delar &amp; jobb
        </div>
      </div>
    </div>

    <!-- Populära reparationer att skicka in -->
    <h2 class="section-title">
      Vad kan du skicka in? <span>Populära tjänster</span>
    </h2>
    <div
      style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-bottom: 4rem;"
    >
      <!-- PS5 & Xbox Kontroller TMR -->
      <div class="service-card featured">
        <div class="tags-row">
          <span class="service-tag bundle-tag">🎮 Kontroll</span>
          <span class="service-tag time">⚡ 24h</span>
        </div>
        <h3 style="font-size: 1.25rem; color: #fff; margin: 0.5rem 0 0.2rem;">
          TMR Sensor Uppgradering
        </h3>
        <p
          style="color: var(--accent); font-weight: 800; font-size: 1.5rem; margin: 0;"
        >
          449 kr <small
            style="font-size: 0.9rem; color: var(--text-dim); font-weight: normal;"
            >(PS5 / Xbox Series)</small>
        </p>
        <p
          style="color: var(--text-dim); font-size: 0.92rem; margin-top: 0.5rem;"
        >
          Byt ut mekaniska potentiometrar mot kontaktlösa magnetiska
          TMR-sensorer. Eliminerar stick drift för alltid.
        </p>
        <a
          href="/tjanster/tmr-sticks/"
          style="color: var(--accent); font-weight: 700; font-size: 0.85rem;"
          >Läs mer om TMR →</a
        >
      </div>

      <!-- HDMI-port Byte Konsol -->
      <div class="service-card featured">
        <div class="tags-row">
          <span class="service-tag new-tag">🔌 Hårdvara</span>
          <span class="service-tag time">⚡ 24–48h</span>
        </div>
        <h3 style="font-size: 1.25rem; color: #fff; margin: 0.5rem 0 0.2rem;">
          HDMI-port Byte Konsoler
        </h3>
        <p
          style="color: var(--accent); font-weight: 800; font-size: 1.5rem; margin: 0;"
        >
          1 199 kr <small
            style="font-size: 0.9rem; color: var(--text-dim); font-weight: normal;"
            >(PS5 / Xbox / PS4)</small>
        </p>
        <p
          style="color: var(--text-dim); font-size: 0.92rem; margin-top: 0.5rem;"
        >
          Svart skärm, ingen signal eller böjda stift? Vi mikrolöder dit en ny
          förstärkt originalport med 6 månaders garanti.
        </p>
        <a
          href="/tjanster/hdmi-port-byte/"
          style="color: var(--accent); font-weight: 700; font-size: 0.85rem;"
          >Läs mer om HDMI-byte →</a
        >
      </div>

      <!-- Konsolservice & Rengöring -->
      <div class="service-card">
        <div class="tags-row">
          <span class="service-tag bundle-tag">❄️ Kylning</span>
          <span class="service-tag time">⚡ 24–48h</span>
        </div>
        <h3 style="font-size: 1.25rem; color: #fff; margin: 0.5rem 0 0.2rem;">
          Rengöring &amp; Liquid Metal
        </h3>
        <p
          style="color: var(--accent); font-weight: 800; font-size: 1.5rem; margin: 0;"
        >
          649 kr <small
            style="font-size: 0.9rem; color: var(--text-dim); font-weight: normal;"
            >(PS5 / Xbox Series)</small>
        </p>
        <p
          style="color: var(--text-dim); font-size: 0.92rem; margin-top: 0.5rem;"
        >
          Låter fläkten som ett jetplan? Djuprengöring av kylflänsar och byte
          till flytande metall (PS5) eller premium kylpasta.
        </p>
        <a
          href="/tjanster/konsolrengoring/"
          style="color: var(--accent); font-weight: 700; font-size: 0.85rem;"
          >Läs mer om konsolrengöring →</a
        >
      </div>

      <!-- Nintendo Joy-Con & Switch -->
      <div class="service-card">
        <div class="tags-row">
          <span class="service-tag bundle-tag">🔴 Nintendo</span>
          <span class="service-tag time">⚡ 24h</span>
        </div>
        <h3 style="font-size: 1.25rem; color: #fff; margin: 0.5rem 0 0.2rem;">
          Joy-Con TMR Uppgradering
        </h3>
        <p
          style="color: var(--accent); font-weight: 800; font-size: 1.5rem; margin: 0;"
        >
          299 kr <small
            style="font-size: 0.9rem; color: var(--text-dim); font-weight: normal;"
            >(1 st) / 399 kr (par)</small>
        </p>
        <p
          style="color: var(--text-dim); font-size: 0.92rem; margin-top: 0.5rem;"
        >
          Få slut på Joy-Con drift en gång för alla. Vi byter till Hall Effect /
          TMR magnetiska moduler för perfekt precision.
        </p>
        <a
          href="/tjanster/joycon-reparation/"
          style="color: var(--accent); font-weight: 700; font-size: 0.85rem;"
          >Läs mer om Joy-Cons →</a
        >
      </div>

      <!-- Retro Recap & Cartridge -->
      <div class="service-card">
        <div class="tags-row">
          <span class="service-tag bundle-tag">📺 Retro</span>
          <span class="service-tag time">⚡ 2–3 dgr</span>
        </div>
        <h3 style="font-size: 1.25rem; color: #fff; margin: 0.5rem 0 0.2rem;">
          Retro &amp; Game Boy / Game Gear
        </h3>
        <p
          style="color: var(--accent); font-weight: 800; font-size: 1.5rem; margin: 0;"
        >
          fr. 199 kr
        </p>
        <p
          style="color: var(--text-dim); font-size: 0.92rem; margin-top: 0.5rem;"
        >
          Pokémon sparbatteribyte (199 kr), SEGA Game Gear recap (749 kr),
          PS1/PS2 spakbyten och GameCube PicoBoot mod.
        </p>
        <a
          href="/tjanster/cartridge-batteribyte/"
          style="color: var(--accent); font-weight: 700; font-size: 0.85rem;"
          >Läs mer om retro →</a
        >
      </div>

      <!-- Custom Mods & Clicky buttons -->
      <div class="service-card">
        <div class="tags-row">
          <span class="service-tag bundle-tag">🛠️ Custom</span>
          <span class="service-tag time">⚡ 24–48h</span>
        </div>
        <h3 style="font-size: 1.25rem; color: #fff; margin: 0.5rem 0 0.2rem;">
          Custom Mods &amp; Laddportar
        </h3>
        <p
          style="color: var(--accent); font-weight: 800; font-size: 1.5rem; margin: 0;"
        >
          fr. 299 kr
        </p>
        <p
          style="color: var(--text-dim); font-size: 0.92rem; margin-top: 0.5rem;"
        >
          Clicky mouse-triggers, paddlar, skalbyten och USB-C konvertering på
          PS4 DualShock 4 eller glappa PS5-portar.
        </p>
        <a
          href="/tjanster/custom-mods/"
          style="color: var(--accent); font-weight: 700; font-size: 0.85rem;"
          >Läs mer om mods →</a
        >
      </div>
    </div>

    <!-- Specifik produktsektion: Köp färdig kontroll istället för att skicka in -->
    <ProductPromo
      badge="⚡ SLIPP VÄNTA PÅ POSTGÅNG"
      title="Vill du hellre köpa en färdigbyggd kontroll direkt?"
      subtitle="Har du bråttom eller vill ha en extra kontroll redo för match? Vi har färdigmoddade handkontroller för PS5 och Xbox med magnetiska TMR-sensorer klara att skickas med PostNord samma dag!"
      slugs={[
        "ps5-dualsense-white-tmr-clicky-mod-174",
        "xbox-series-controller-carbon-black-tmr-171"
      ]}
      ctaText="KÖP VÅRA MODIFIERADE KONTROLLER HÄR →"
      ctaLink="/produkter/?kategori=kontroller"
    />

    <!-- Packguide Section -->
    <section
      id="packguide"
      style="background: rgba(15, 23, 42, 0.7); border: 1px solid var(--border); border-radius: 20px; padding: 2.5rem; margin: 4rem 0;"
    >
      <h2
        style="color: var(--accent); font-size: 1.8rem; text-align: center; margin-top: 0; margin-bottom: 1rem;"
      >
        📦 Packguide: Så emballerar du säkert inför transport
      </h2>
      <p
        style="text-align: center; color: var(--text-dim); max-width: 700px; margin: 0 auto 2.5rem;"
      >
        Att skicka elektronik är tryggt så länge du emballerar ordentligt. Följ
        dessa enkla tips för att säkerställa att din kontroll eller konsol
        färdas oskadd i posthanteringen:
      </p>

      <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;"
      >
        <div
          style="background: var(--card-bg); padding: 1.8rem; border-radius: 14px; border: 1px solid var(--border);"
        >
          <div style="font-size: 2rem; margin-bottom: 0.8rem;">
            🎮 För handkontroller
          </div>
          <ul
            style="list-style: none; padding: 0; margin: 0; color: var(--text-dim); font-size: 0.95rem; display: flex; flex-direction: column; gap: 0.8rem;"
          >
            <li>
              <strong>❌ Undvik mjuka kuvert:</strong> Skicka aldrig en handkontroll
              i ett vadderat kuvert! Sorteringsmaskiner kan trycka sönder styrspakarna
              eller krossa skalet.
            </li>
            <li>
              <strong>✅ Använd hård kartong:</strong> En liten skokartong eller en
              PostNord Blå påse M / kartong är perfekt.
            </li>
            <li>
              <strong>✅ Vira in i bubbelplast:</strong> Ge kontrollen 2–3 lager bubbelplast
              eller skrynklat papper så att spakarna inte ligger pressade mot kartongväggen.
            </li>
            <li>
              <strong>✅ Lägg i en kontaktlapp:</strong> Skriv ditt namn, telefonnummer
              och returadress på ett papper inuti kartongen.
            </li>
          </ul>
        </div>

        <div
          style="background: var(--card-bg); padding: 1.8rem; border-radius: 14px; border: 1px solid var(--border);"
        >
          <div style="font-size: 2rem; margin-bottom: 0.8rem;">
            🖥️ För spelkonsoler (PS5, Xbox, m.fl.)
          </div>
          <ul
            style="list-style: none; padding: 0; margin: 0; color: var(--text-dim); font-size: 0.95rem; display: flex; flex-direction: column; gap: 0.8rem;"
          >
            <li>
              <strong>✅ Skicka enbart konsolen:</strong> Lämna strömkabel, HDMI-kabel
              och stativ hemma (om vi inte specifikt bett om dem för felsökning).
            </li>
            <li>
              <strong>✅ Minst 5 cm stötdämpning:</strong> Konsoler är tunga. Se till
              att det finns rikligt med bubbelplast eller skum runt alla hörn och
              kanter.
            </li>
            <li>
              <strong>✅ Skaka kartongen lätt:</strong> Konsolen ska ligga helt still
              i lådan och inte glida runt vid rörelse.
            </li>
            <li>
              <strong>✅ Tejpa ordentligt:</strong> Förslut kartongens alla skarvar
