---
// src/pages/produkter/index.astro
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { products, type Product } from "../../data/products";

const countAll = products.length;
const countControllers = products.filter((p) => p.category === "kontroller").length;
const countParts = products.filter((p) => p.category === "reservdelar").length;
const countConsoles = products.filter((p) => p.category === "konsoler" || p.category === "tillbehor").length;

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "mkFix Butik & Produktgalleri | Handkontroller & Reservdelar",
  "description": "Köp färdigmoddade TMR-handkontroller, renoverade retrokonsoler och kvalitativa reservdelar i Malmö.",
  "itemListElement": products.map((product, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "url": `https://mkfix.se/produkter/${product.slug}/`,
    "name": product.title
  }))
};
---

<MainLayout
  title="Butik & Produktgalleri | Kontroller & Reservdelar | mkFix Malmö"
  description="Köp färdigmoddade PS5 & Switch-kontroller med TMR-sensorer, äkta Alps-joysticks och reservdelar. Testade i Malmö-verkstan. Enkel beställning utan krångel!"
  keywords="köpa laga handkontroll, ps5 dualsense tmr, k-silver tmr reservdelar, nintendo switch joy-con, sega game gear recap kit, cr2025 batteribyte pokemon, mkfix butik malmö"
  ogTitle="mkFix Butik & Produktgalleri | Kontroller & Reservdelar"
  ogDescription="Handbyggda och driftfria kontroller, noggrant testade reservdelar och retrokonsoler. 6 mån garanti & snabb leverans."
  canonicalUrl="https://mkfix.se/produkter/"
  jsonLd={itemListSchema}
>
  <Header />

  <main class="container">
    <!-- Hero Header -->
    <section class="hero shop-hero">
      <div class="trust-box">
        <span class="trust-badge">MKFIX BUTIK</span>
        <span>Testat &amp; kvalitetssäkrat i verkstaden</span>
      </div>

      <h1>
        mkFix <span>Butik &amp; Galleri</span>
      </h1>

      <p class="shop-lead">
        Här hittar du färdigmoddade handkontroller med magnetiska TMR-sensorer, testade retrokonsoler och noga utvalda reservdelar. 
        Varje enhet är noggrant lödd, kalibrerad och testad i vår Malmö-verkstad med <strong>6 månaders garanti</strong>.
      </p>

      <!-- Trust Badges Bar -->
      <div class="shop-perks">
        <div class="perk-item">
          <span class="perk-icon">⚡</span>
          <span>Snabb leverans / Hämtning i Malmö</span>
        </div>
        <div class="perk-item">
          <span class="perk-icon">🛡️</span>
          <span>6 månaders funktionsgaranti</span>
        </div>
        <div class="perk-item">
          <span class="perk-icon">💬</span>
          <span>Smidig beställning via SMS &amp; Swish</span>
        </div>
      </div>
    </section>

    <!-- Trade-In & Buyback Info Banner -->
    <section class="shop-tradein-banner">
      <div class="tradein-badge">♻️ VI KÖPER DINA KONTROLLER &amp; INBYTE</div>
      <div class="tradein-body">
        <div class="tradein-text">
          <h3>Har du gamla eller trasiga kontroller liggande? Sälj dem till oss!</h3>
          <p>
            Vi köper in handkontroller för PS5, Xbox, Switch och retro – defekta med stick drift eller fungerande. 
            Få <strong>pengar via Swish</strong> samma dag eller byt in din gamla kontroll för <strong>extra rabatt</strong> på en ny TMR-moddad enhet!
          </p>
        </div>
        <div class="tradein-actions">
          <a href="/vi-koper-kontroller" class="tradein-btn">SE PRISLISTA &amp; SÄLJ HÄR →</a>
          <span class="tradein-subtext">Eller SMS:a 079-032 06 05 direkt</span>
        </div>
      </div>
    </section>

    <!-- Category Filter Tabs -->
    <div class="shop-filter-bar">
      <button class="filter-tab active" data-filter="all">
        Alla produkter <span class="tab-count">({countAll})</span>
      </button>
      <button class="filter-tab" data-filter="kontroller">
        🎮 Handkontroller <span class="tab-count">({countControllers})</span>
      </button>
      <button class="filter-tab" data-filter="reservdelar">
        🔧 Reservdelar <span class="tab-count">({countParts})</span>
      </button>
      {countConsoles > 0 && (
        <button class="filter-tab" data-filter="konsoler">
          🕹️ Konsoler &amp; Tillbehör <span class="tab-count">({countConsoles})</span>
        </button>
      )}
    </div>

    <!-- Product Grid Gallery -->
    <div class="products-grid" id="products-grid">
      {products.map((product) => {
        const primaryImage = product.images[0] || "/favicon.svg";
        
        // Status formatting
        let statusText = "I lager";
        let statusClass = "status-instock";
        if (product.status === "few_left") {
          statusText = "Få kvar";
          statusClass = "status-fewleft";
        } else if (product.status === "made_to_order") {
          statusText = "Beställningsvara";
          statusClass = "status-order";
        } else if (product.status === "sold_out") {
          statusText = "Slut i lager";
          statusClass = "status-soldout";
        }

        return (
          <article class="product-card" data-category={product.category}>
            <a href={`/produkter/${product.slug}`} class="card-image-link" aria-label={`Visa ${product.title}`}>
              <div class="card-image-wrapper">
                <img
                  src={primaryImage}
                  alt={product.title}
                  loading="lazy"
                  class="card-img"
                />
                
                {product.badge && (
                  <span class="product-badge">{product.badge}</span>
                )}

                <span class={`status-pill ${statusClass}`}>
                  <span class="status-dot"></span>
                  {statusText}
                </span>

                {product.images.length > 1 && (
                  <span class="photos-count-badge">
                    📷 {product.images.length} bilder
                  </span>
                )}
              </div>
            </a>

            <div class="card-content">
              <div class="card-header-row">
                <span class="category-tag">
                  {product.category === "kontroller" && "🎮 Handkontroll"}
                  {product.category === "reservdelar" && "🔧 Reservdel"}
                  {product.category === "konsoler" && "🕹️ Konsol"}
                  {product.category === "tillbehor" && "🔌 Tillbehör"}
                </span>
                <span class="warranty-hint">✓ {product.warranty}</span>
              </div>

              <h2 class="product-card-title">
                <a href={`/produkter/${product.slug}`}>{product.title}</a>
              </h2>

              <p class="product-card-desc">{product.shortDescription}</p>

              <div class="card-footer-row">
                <div class="price-box">
                  {product.originalPrice && (
                    <span class="price-original">{product.originalPrice} kr</span>
                  )}
                  <span class="price-current">{product.price} <small>kr</small></span>
                </div>

                <a href={`/produkter/${product.slug}`} class="view-btn">
                  Se detaljer &amp; bilder →
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- How buying works banner -->
    <section class="how-to-buy-box">
      <div class="how-header">
        <h3>🛒 Hur handlar jag i mkFix-butiken?</h3>
        <p>Vi skippar krångliga betallösningar och kortavgifter. Här handlar du direkt av verkstan:</p>
      </div>

      <div class="how-steps-grid">
        <div class="how-step">
          <div class="step-badge">1</div>
          <h4>Välj föremål</h4>
          <p>Klicka in på den produkt eller reservdel du är intresserad av och kolla igenom bilderna.</p>
        </div>
        <div class="how-step">
          <div class="step-badge">2</div>
          <h4>Klicka på Köp via SMS</h4>
          <p>Varje produktsida har en direkt SMS-knapp med förifyllt meddelande (eller ring / mejla).</p>
        </div>
        <div class="how-step">
          <div class="step-badge">3</div>
          <h4>Swisha &amp; Ta emot</h4>
          <p>Betala enkelt med Swish. Hämta direkt på plats i Malmö eller få spårbart paket via PostNord inom 24-48 timmar.</p>
        </div>
      </div>

      <div class="how-action">
        <span>Vill du hellre att vi lagar din egen kontroll?</span>
        <a href="/#boka" class="link-btn">Boka reparation istället →</a>
      </div>
    </section>
  </main>

  <Footer />

  <!-- Filter JavaScript -->
  <script is:inline>
    const filterButtons = document.querySelectorAll(".filter-tab");
    const productCards = document.querySelectorAll(".product-card");

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterButtons.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");

        const filter = btn.getAttribute("data-filter");

        productCards.forEach((card) => {
          const cardCategory = card.getAttribute("data-category");
          if (filter === "all" || cardCategory === filter) {
            card.style.display = "flex";
          } else {
            card.style.display = "none";
          }
        });
      });
    });
  </script>
</MainLayout>

<style>
  .shop-hero {
    padding: 5rem 0 2.5rem;
  }

  .shop-lead {
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--text-dim);
    max-width: 800px;
    margin: 0 auto 2rem;
  }

  .shop-perks {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .perk-item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    padding: 8px 16px;
    border-radius: 30px;
    font-size: 0.9rem;
    color: var(--text-main);
  }

  .perk-icon {
    font-size: 1.1rem;
  }

  /* Trade-in / Buyback Banner in Shop */
  .shop-tradein-banner {
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.08) 0%, rgba(30, 41, 59, 0.95) 50%, rgba(15, 23, 42, 0.95) 100%);
    border: 1px solid rgba(34, 197, 94, 0.35);
    border-radius: 18px;
    padding: 1.75rem 2.25rem;
    margin: 2rem 0 2.5rem;
    position: relative;
    box-shadow: 0 10px 30px rgba(34, 197, 94, 0.06);
    transition: transform 0.25s ease, border-color 0.25s ease;
  }

  .shop-tradein-banner:hover {
    border-color: #22c55e;
    transform: translateY(-2px);
    box-shadow: 0 14px 35px rgba(34, 197, 94, 0.12);
  }

  .tradein-badge {
    display: inline-block;
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
    border: 1px solid rgba(34, 197, 94, 0.3);
    padding: 3px 12px;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.5px;
    margin-bottom: 0.75rem;
  }

  .tradein-body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .tradein-text h3 {
    font-size: 1.35rem;
    color: #fff;
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  .tradein-text p {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
    max-width: 650px;
  }

  .tradein-text strong {
    color: #fff;
  }

  .tradein-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .tradein-btn {
    background: #22c55e;
    color: #0f172a;
    text-decoration: none;
    font-weight: 800;
    font-size: 0.92rem;
    padding: 13px 22px;
    border-radius: 10px;
    white-space: nowrap;
    transition: transform 0.2s, box-shadow 0.2s;
    box-shadow: 0 4px 15px rgba(34, 197, 94, 0.25);
    text-align: center;
  }

  .tradein-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(34, 197, 94, 0.4);
  }

  .tradein-subtext {
    font-size: 0.8rem;
    color: var(--text-dim);
  }

  @media (max-width: 820px) {
    .shop-tradein-banner {
      padding: 1.5rem 1.25rem;
    }
    .tradein-body {
      flex-direction: column;
      align-items: stretch;
      gap: 1.25rem;
    }
    .tradein-actions {
      width: 100%;
    }
    .tradein-btn {
      width: 100%;
    }
  }

  /* Filter Tab Bar */
  .shop-filter-bar {
    display: flex;
    justify-content: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin: 2rem 0 3rem;
  }

  .filter-tab {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    color: var(--text-main);
    padding: 10px 20px;
    border-radius: 12px;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .filter-tab:hover {
    border-color: var(--accent);
    background: rgba(56, 189, 248, 0.08);
  }

  .filter-tab.active {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  .filter-tab.active .tab-count {
    color: var(--bg);
    opacity: 0.85;
  }

  .tab-count {
    font-size: 0.85rem;
    color: var(--text-dim);
    font-weight: 500;
  }

  /* Product Grid */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 2rem;
    margin-bottom: 5rem;
  }

  .product-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .product-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent);
    box-shadow: 0 12px 30px rgba(56, 189, 248, 0.15);
  }

  .card-image-link {
    text-decoration: none;
    display: block;
  }

  .card-image-wrapper {
    position: relative;
    aspect-ratio: 16 / 11;
    overflow: hidden;
    background: #090d16;
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .product-card:hover .card-img {
    transform: scale(1.05);
  }

  .product-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(56, 189, 248, 0.4);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
    letter-spacing: 0.3px;
  }

  .status-pill {
    position: absolute;
    top: 12px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
    backdrop-filter: blur(8px);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }

  .status-instock {
    background: rgba(34, 197, 94, 0.2);
    border: 1px solid rgba(34, 197, 94, 0.5);
    color: #4ade80;
  }
  .status-instock .status-dot {
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
  }

  .status-fewleft {
    background: rgba(245, 158, 11, 0.2);
    border: 1px solid rgba(245, 158, 11, 0.5);
    color: #fbbf24;
  }
  .status-fewleft .status-dot {
    background: #f59e0b;
  }

  .status-order {
    background: rgba(56, 189, 248, 0.2);
    border: 1px solid rgba(56, 189, 248, 0.5);
    color: var(--accent);
  }
  .status-order .status-dot {
    background: var(--accent);
  }

  .status-soldout {
    background: rgba(148, 163, 184, 0.2);
    border: 1px solid rgba(148, 163, 184, 0.5);
    color: #94a3b8;
  }
  .status-soldout .status-dot {
    background: #94a3b8;
  }

  .photos-count-badge {
    position: absolute;
    bottom: 10px;
    right: 10px;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(6px);
    color: var(--text-dim);
    font-size: 0.75rem;
    padding: 3px 8px;
    border-radius: 6px;
  }

  /* Card Content */
  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    font-size: 0.8rem;
  }

  .category-tag {
    color: var(--accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .warranty-hint {
    color: var(--text-dim);
  }

  .product-card-title {
    font-size: 1.25rem;
    margin: 0 0 0.5rem 0;
    line-height: 1.35;
  }

  .product-card-title a {
    color: var(--text-main);
    text-decoration: none;
    transition: color 0.2s;
  }

  .product-card-title a:hover {
    color: var(--accent);
  }

  .product-card-desc {
    color: var(--text-dim);
    font-size: 0.92rem;
    line-height: 1.55;
    margin-bottom: 1.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer-row {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    gap: 1rem;
  }

  .price-box {
    display: flex;
    flex-direction: column;
  }

  .price-original {
    font-size: 0.8rem;
    color: var(--text-dim);
    text-decoration: line-through;
    line-height: 1;
  }

  .price-current {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--accent);
    line-height: 1.1;
  }

  .price-current small {
    font-size: 0.9rem;
    color: var(--text-dim);
    font-weight: 600;
  }

  .view-btn {
    background: rgba(56, 189, 248, 0.1);
    color: var(--accent);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 8px 14px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.88rem;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .view-btn:hover {
    background: var(--accent);
    color: var(--bg);
    border-color: var(--accent);
  }

  /* How To Buy Box */
  .how-to-buy-box {
    background: linear-gradient(145deg, rgba(30, 41, 59, 0.8), rgba(15, 23, 42, 0.9));
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 3rem 2.5rem;
    margin-bottom: 5rem;
  }

  .how-header {
    text-align: center;
    max-width: 600px;
    margin: 0 auto 2.5rem;
  }

  .how-header h3 {
    font-size: 1.6rem;
    color: var(--text-main);
    margin-bottom: 0.5rem;
  }

  .how-header p {
    color: var(--text-dim);
    font-size: 1rem;
  }

  .how-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .how-step {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 14px;
    padding: 1.75rem 1.5rem;
    position: relative;
  }

  .step-badge {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg);
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .how-step h4 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
    color: var(--text-main);
  }

  .how-step p {
    color: var(--text-dim);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .how-action {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.95rem;
  }

  .link-btn {
    color: var(--accent);
    text-decoration: none;
    font-weight: 700;
  }

  .link-btn:hover {
    text-decoration: underline;
  }
</style>