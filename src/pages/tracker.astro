---
// src/pages/tracker.astro
import initialFlips from '../data/flips.json';

const parsedLedger = initialFlips.map(flip => {
    const totalCost = flip.buyPrice + flip.partsPrice;
    const netProfit = flip.sellPrice - totalCost - flip.salesFee;
    return {
        ...flip,
        totalCost,
        netProfit
    };
});
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YouTube Repair Flip Tracker with Time Travel</title>
    <script src="https://cdn.jsdelivr.net/npm/chart.js" is:inline></script>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f4f7f6;
            color: #333;
            margin: 0;
            padding: 20px;
        }
        .container {
            max-width: 1100px;
            margin: 0 auto;
        }
        h1 { text-align: center; color: #2c3e50; margin-bottom: 20px; }
        
        /* 🔐 PASSWORD GATE STYLES */
        .gate-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 80vh;
        }
        .gate-card {
            background: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            text-align: center;
            max-width: 400px;
            width: 100%;
        }
        .gate-card h2 { color: #2c3e50; margin-top: 0; }
        .gate-card input {
            width: 100%;
            padding: 12px;
            margin: 15px 0;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
            font-size: 16px;
            text-align: center;
        }
        .gate-card button {
            width: 100%;
            background-color: #34495e;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 4px;
            font-size: 16px;
            cursor: pointer;
            font-weight: bold;
        }
        .gate-card button:hover { background-color: #2c3e50; }
        .error-text { color: #c0392b; font-weight: bold; margin-top: 10px; display: none; }

        /* TRACKER STYLES */
        .view-panel {
            background: #34495e;
            color: white;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .view-panel label { font-weight: bold; font-size: 16px; margin: 0; }
        .view-panel select {
            padding: 8px 15px;
            font-size: 16px;
            border-radius: 4px;
            border: none;
            font-weight: bold;
            cursor: pointer;
            background: white;
            color: #2c3e50;
        }

        .dashboard {
            display: flex;
            gap: 20px;
            margin-bottom: 25px;
        }
        .card {
            flex: 1;
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            text-align: center;
        }
        .card h3 { margin: 0 0 10px 0; color: #7f8c8d; font-size: 14px; text-transform: uppercase; }
        .card p { margin: 0; font-size: 28px; font-weight: bold; }
        .profit { color: #27ae60; }
        .balance { color: #2980b9; }
        
        .visuals-section {
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            margin-bottom: 25px;
            height: 320px;
        }
        
        .main-content {
            display: flex;
            flex-direction: column-reverse;
        }
        form {
            background: white;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            height: fit-content;
            margin-top: 25px;
        }
        form h2 { margin-top: 0; font-size: 18px; color: #2c3e50; }
        .form-group { margin-bottom: 15px; }
        label { display: block; margin-bottom: 5px; font-weight: 600; font-size: 14px; }
        input {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
        }
        button {
            width: 100%;
            background-color: #27ae60;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 4px;
            font-size: 16px;
            cursor: pointer;
            font-weight: bold;
            transition: background 0.2s;
        }
        button:hover { background-color: #219653; }
        
        table {
            width: 100%;
            background: white;
            border-collapse: collapse;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
        }
        th, td { padding: 12px; text-align: left; border-bottom: 1px solid #eee; }
        th { background-color: #34495e; color: white; }
        .gray-out { opacity: 0.3; }
    </style>
</head>
<body>

<div id="password-screen" class="gate-wrapper">
    <div class="gate-card">
        <h2>🔐 Locked Workspace</h2>
        <p style="color: #7f8c8d; font-size: 14px;">Please enter your password to access the flip metrics ledger.</p>
        <input type="password" id="gate-password" placeholder="Enter Password..." />
        <button id="gate-submit">Unlock Dashboard</button>
        <p id="gate-error" class="error-text">❌ Incorrect Password. Access Denied.</p>
    </div>
</div>

<div id="tracker-app" class="container" style="display: none;">
    <h1>🎬 Tuggs and tears</h1>
    
    <div class="view-panel">
        <label for="episode-view-select">🎬 Screenshot Mode (Filter View):</label>
        <select id="episode-view-select">
            <option value="latest">Show Latest (Full History)</option>
            {parsedLedger.map((flip, index) => (
                <option value={index}>Up to: {flip.name}</option>
            ))}
        </select>
    </div>

    <div class="dashboard">
        <div class="card">
            <h3>Starting Budget</h3>
            <p>€80.00</p>
        </div>
        <div class="card">
            <h3>Current Bankroll</h3>
            <p id="current-balance" class="balance">€80.00</p>
        </div>
        <div class="card">
            <h3>Total Net Profit</h3>
            <p id="total-profit" class="profit">€0.00</p>
        </div>
    </div>

    <div class="visuals-section">
        <canvas id="progressChart"></canvas>
    </div>

    <div class="main-content">
        <form id="flip-form">
            <h2>Simulate New Flip</h2>
            <div class="form-group">
                <label for="item-name">Item Name / Episode Title</label>
                <input type="text" id="item-name" placeholder="e.g., Ep 3: Xbox One" required>
            </div>
            <div class="form-group">
                <label for="buy-price">Purchase Price (€)</label>
                <input type="number" id="buy-price" step="0.01" required>
            </div>
            <div class="form-group">
                <label for="parts-price">Spare Parts Cost (€)</label>
                <input type="number" id="parts-price" step="0.01" value="0">
            </div>
            <div class="form-group">
                <label for="sell-price">Sold Price (€)</label>
                <input type="number" id="sell-price" step="0.01" required>
            </div>
            <div class="form-group">
                <label for="sales-fee">Sales Fee / Platform Fee (€)</label>
                <input type="number" id="sales-fee" step="0.01" value="0">
            </div>
            <button type="submit">Add Temporary Simulation</button>
        </form>

        <div>
            <table>
                <thead>
                    <tr>
                        <th>Item / Episode</th>
                        <th>Cost (Buy + Parts)</th>
                        <th>Sales Fee</th>
                        <th>Sold</th>
                        <th>Net Profit</th>
                    </tr>
                </thead>
                <tbody id="inventory-table">
                    {parsedLedger.map((flip) => (
                        <tr>
                            <td><strong>{flip.name}</strong></td>
                            <td>€{flip.totalCost.toFixed(2)} <small style="color:#7f8c8d;">(€{flip.buyPrice} + €{flip.partsPrice})</small></td>
                            <td>€{flip.salesFee.toFixed(2)}</td>
                            <td>€{flip.sellPrice.toFixed(2)}</td>
                            <td style={`color: ${flip.netProfit >= 0 ? '#27ae60' : '#c0392b'}; font-weight:bold;`}>
                                {flip.netProfit >= 0 ? '+' : ''}€{flip.netProfit.toFixed(2)}
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script define:vars={{ parsedLedger, STARTING_BUDGET: 80.00 }}>
    // 🔧 CHANGE THIS TO YOUR DESIRED TRACKER PASSWORD
    const SECRET_ACCESS_KEY = "mkisbaldandbeautiful!"; 

    // Access elements
    const passwordScreen = document.getElementById('password-screen');
    const trackerApp = document.getElementById('tracker-app');
    const passwordInput = document.getElementById('gate-password');
    const submitBtn = document.getElementById('gate-submit');
    const errorText = document.getElementById('gate-error');

    // Verification Logic
    function checkPassword() {
        if (passwordInput.value === SECRET_ACCESS_KEY) {
            passwordScreen.style.display = 'none';
            trackerApp.style.display = 'block';
            
            // Render chart and calculations only after successful unlock
            initChartAndMetrics();
        } else {
            errorText.style.display = 'block';
            passwordInput.value = '';
        }
    }

    // Event listeners for unlocking
    submitBtn.addEventListener('click', checkPassword);
    passwordInput.addEventListener('keydown', (e) => { if(e.key === 'Enter') checkPassword(); });

    // Global variable for the ledger array
    let flipLedger = [...parsedLedger];
    let progressChart;

    function initChartAndMetrics() {
        const ctx = document.getElementById('progressChart').getContext('2d');
        progressChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Start'],
                datasets: [{
                    label: 'Wallet Balance (€)',
                    data: [STARTING_BUDGET],
                    borderColor: '#2980b9',
                    backgroundColor: 'rgba(41, 128, 185, 0.1)',
                    borderWidth: 3,
                    tension: 0.2,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { title: { display: true, text: 'Funds (€)' } }
                }
            }
        });

        // Initialize display stats
        updateDisplay();
    }

    function updateDisplay(cutoffIndex = flipLedger.length) {
        let calcBalance = STARTING_BUDGET;
        let calcProfit = 0.00;
        
        let chartLabels = ['Start'];
        let chartData = [STARTING_BUDGET];
        
        for (let i = 0; i < cutoffIndex; i++) {
            const flip = flipLedger[i];
            calcBalance += flip.netProfit;
            calcProfit += flip.netProfit;
            
            chartLabels.push(flip.name);
            chartData.push(calcBalance);
        }

        document.getElementById('current-balance').innerText = `€${calcBalance.toFixed(2)}`;
        document.getElementById('total-profit').innerText = `€${calcProfit.toFixed(2)}`;
        document.getElementById('current-balance').style.color = calcBalance < 0 ? '#c0392b' : '#2980b9';

        progressChart.data.labels = chartLabels;
        progressChart.data.datasets[0].data = chartData;
        progressChart.update();

        const rows = document.getElementById('inventory-table').children;
        for (let i = 0; i < rows.length; i++) {
            if (i >= cutoffIndex) {
                rows[i].classList.add('gray-out');
            } else {
                rows[i].classList.remove('gray-out');
            }
        }
    }

    document.getElementById('episode-view-select').addEventListener('change', function(e) {
        const val = e.target.value;
        if (val === 'latest') {
            updateDisplay(flipLedger.length);
        } else {
            updateDisplay(parseInt(val) + 1);
        }
    });

    document.getElementById('flip-form').addEventListener('submit', function(e) {
        e.preventDefault();

        const name = document.getElementById('item-name').value;
        const buyPrice = parseFloat(document.getElementById('buy-price').value);
        const partsPrice = parseFloat(document.getElementById('parts-price').value);
        const sellPrice = parseFloat(document.getElementById('sell-price').value);
        const salesFee = parseFloat(document.getElementById('sales-fee').value);

        const totalCost = buyPrice + partsPrice;
        const netProfit = sellPrice - totalCost - salesFee;

        flipLedger.push({ name, totalCost, buyPrice, partsPrice, sellPrice, salesFee, netProfit });

        const tableBody = document.getElementById('inventory-table');
        const row = document.createElement('tr');
        row.innerHTML = `
            <td><strong>${name}</strong></td>
            <td>€${totalCost.toFixed(2)} <small style="color:#7f8c8d;">(€${buyPrice} + €${partsPrice})</small></td>
            <td>€${salesFee.toFixed(2)}</td>
            <td>€${sellPrice.toFixed(2)}</td>
            <td style="color: ${netProfit >= 0 ? '#27ae60' : '#c0392b'}; font-weight:bold;">
                ${netProfit >= 0 ? '+' : ''}€${netProfit.toFixed(2)}
            </td>
        `;
        tableBody.appendChild(row);

        const dropdown = document.getElementById('episode-view-select');
        const option = document.createElement('option');
        option.value = flipLedger.length - 1;
        option.text = `Up to: ${name}`;
        dropdown.appendChild(option);

        dropdown.value = 'latest';
        updateDisplay(flipLedger.length);

        document.getElementById('flip-form').reset();
        document.getElementById('parts-price').value = 0;
        document.getElementById('sales-fee').value = 0;
    });
</script>

</body>
</html>