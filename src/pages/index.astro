---
// src/pages/index.astro
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
interface Props {
	title?: string;
	description?: string;
}
const { title, description } = Astro.props;
---

<MainLayout
	title="Laga Handkontroll Malmö | Stick Drift & TMR Fix | mkFix"
	description="Fixa stick drift permanent i Malmö! TMR & Hall Effect uppgraderingar för PS5, Xbox och Switch. Snabbt med 6 månaders garanti."
	keywords="stick drift repair malmö, laga handkontroll malmö, TMR sensor upgrade, laga PS5 kontroll malmö, nintendo switch lagning"
	ogTitle="mkFix - Säg hejdå till Stick Drift"
	ogDescription="Vi uppgraderar din kontroll till nästa nivå med TMR-stickor och custom mods i Malmö."
	canonicalUrl="https://mkfix.se"
>
	<Header />
	<main class="container">
        <section class="hero">
            <div class="trust-box">
                <span class="trust-badge">6 MÅN GARANTI</span>
                <span>Specialist-service i Malmö</span>
            </div>
            <h1>Laga & uppgradera handkontroller i Malmö</h1>
            <p>Har din handkontroll börjat <strong>drifta, tappa precision eller kännas opålitlig?</strong>
                Hos <strong>mkFix</strong> jobbar vi med <strong>reparation och uppgradering av handkontroller</strong>,
                där vi <strong>fixar stick drift</strong> och <strong>byter ut slitna komponenter</strong> för att få
                tillbaka känslan i spelet. <br />
                Oavsett om det handlar om en <strong>snabb lagning</strong> eller en mer <strong>hållbar
                    TMR-uppgradering</strong> ser vi till att din kontroll fungerar som den ska igen
            </p>
            <a href="#boka" class="contact-method"
                style="font-size: 1.2rem; background: var(--accent); color: var(--bg); display: inline-block; padding: 15px 30px; border-radius: 10px;">BOKA
                DIN REPARATION</a>
        </section>

