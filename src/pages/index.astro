    <!-- 1. FIXED: Added enctype="multipart/form-data" for your file upload -->
    <form id="contact-form" class="contact-form" method="POST" enctype="multipart/form-data">
        <div class="form-group">
            <input type="text" name="fi-sender-firstName" placeholder="Ditt namn*" required>
        </div>
        <div class="form-group">
            <input type="email" name="fi-sender-email" placeholder="Din e-post*" required>
        </div>
        <div class="form-group">
            <input type="tel" name="fi-sender-phone" placeholder="070123456">
        </div>
        <div class="form-group">
            <select name="fi-text-enhet" required>
